---
import { getHomepageProjects } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

let projects = [];
try {
  projects = await getHomepageProjects();
} catch (e) {
  projects = [];
}
---

<section id="work" class="w-full px-6 md:px-10 py-10 md:py-12 border-b border-[var(--ink-faint)]/40">
  <div class="w-full flex flex-col gap-6 text-left">
    <!-- Header with Link to All Projects -->
    <div class="flex justify-between items-baseline">
      <div class="flex items-baseline gap-4">
        <span class="accent-hover-bracket inline-block font-mono text-[11px] text-[var(--ink)] tracking-[0.1em] border border-[var(--ink-faint)] px-2.5 py-1 select-none bg-[#12110E]/80">
          <span class="bracket">[</span> 03 / WORK <span class="bracket">]</span>
        </span>
      </div>

      {projects.length > 0 && (
        <a
          href="/projects"
          class="font-serif italic text-[14px] text-[var(--ink)] hover:text-[var(--accent)] transition-colors flex items-center gap-1.5 group"
        >
          <span>View All Projects</span>
          <span class="font-mono text-[12px] group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      )}
    </div>

    {projects.length === 0 ? (
      /* Editorial Empty State */
      <div class="font-serif italic text-[15px] text-[var(--ink-muted)] py-2">
        Coming soon.
      </div>
    ) : (
      /* Text-Only Homepage Project Cards Grid (No Cover Images or Screenshots) */
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projects.map((project) => (
          <ProjectCard project={project} showMedia={false} />
        ))}
      </div>
    )}
  </div>
</section>
