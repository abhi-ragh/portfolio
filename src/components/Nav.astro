---
interface Props {
  active?: 'about' | 'projects' | 'gallery' | 'others' | '';
}

const { active = '' } = Astro.props;

const items = [
  { id: 'about', label: 'About', href: '/about' },
  { id: 'projects', label: 'Projects', href: '/projects' },
  { id: 'gallery', label: 'Gallery', href: '/archive' },
  { id: 'others', label: 'Others', href: '/others' },
];
---

<nav
  class="inline-flex items-center gap-1 rounded-full border border-[var(--line)] bg-[var(--surface)]/80 p-1 font-mono text-[11.5px] leading-none backdrop-blur-md shadow-xs"
  aria-label="Main navigation"
>
  {items.map((item) => (
    <a
      href={item.href}
      class:list={[
        'rounded-full px-3 py-1.5 transition-all duration-150',
        active === item.id
          ? 'bg-[var(--surface-hover)] font-medium text-[var(--ink)] shadow-2xs'
          : 'text-[var(--ink-secondary)] hover:text-[var(--ink)] hover:bg-[var(--surface-hover)]/60',
      ]}
      aria-current={active === item.id ? 'page' : undefined}
    >
      {item.label}
    </a>
  ))}
</nav>
