---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { getArchiveProjects } from '../lib/projects';

let projects = [];
try {
  projects = await getArchiveProjects();
} catch (e) {
  projects = [];
}
---

<Base title="Projects — Selected Engineering Work | abhiragh a r">
  <div class="w-full max-w-[1536px] mx-auto min-h-screen px-6 sm:px-10 lg:px-12 xl:px-16 flex flex-col lg:flex-row gap-2 sm:gap-4 lg:gap-12 xl:gap-16 relative z-10">
    <Sidebar />

    <main class="flex-1 min-w-0 pt-0 pb-8 lg:py-16 px-0 lg:px-4 xl:px-8">
      <div class="w-full max-w-[920px] xl:max-w-[960px] mx-auto flex flex-col gap-12">
        {/* Header */}
        <div class="flex flex-col gap-3 pb-4">
          <h1 class="font-serif text-[32px] md:text-[44px] text-[var(--ink)] font-normal tracking-tight">
            Engineering Projects
          </h1>
          <p class="font-serif italic text-[15px] text-[var(--ink-faint)] max-w-xl leading-relaxed">
            Engineering projects, infrastructure automations, and side projects.
          </p>
        </div>

        {projects.length === 0 ? (
          <div class="font-serif italic text-[18px] text-[var(--ink-faint)] py-8">
            Projects<br />
            Coming soon.
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 items-start">
            {projects.map((project) => (
              <ProjectCard project={project} showMedia={true} />
            ))}
          </div>
        )}

        <Footer />
      </div>
    </main>
  </div>
</Base>
