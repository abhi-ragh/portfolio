---
interface Props {
  title?: string;
  author?: string;
  coverImage?: string;
  status?: string;
  coverWidth?: number;
  coverHeight?: number;
  variant?: 'horizontal' | 'split-left' | 'split-right' | 'vertical-tall';
}

const {
  title,
  author,
  coverImage,
  status,
  coverWidth,
  coverHeight,
  variant,
} = Astro.props;

const statusLower = (status || '').toLowerCase();
const isFinished = statusLower.startsWith('recently');
const category = isFinished ? 'complete' : 'in-progress';

const statusConfig: Record<string, {
  badgeColor: 'amber' | 'emerald' | 'blue' | 'violet' | 'rose' | 'cyan';
}> = {
  'watching': { badgeColor: 'blue' },
  'playing': { badgeColor: 'violet' },
  'reading': { badgeColor: 'amber' },
  'recently watched': { badgeColor: 'cyan' },
  'recently played': { badgeColor: 'rose' },
  'recently read': { badgeColor: 'emerald' },
};

const config = statusConfig[statusLower] || statusConfig.reading;

const badgeStyles = {
  amber: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20',
  emerald: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20',
  blue: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20',
  violet: 'bg-violet-500/10 text-violet-600 dark:text-violet-400 border border-violet-500/20',
  cyan: 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20',
  rose: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20',
  neutral: 'bg-[var(--surface-hover)] text-[var(--ink-tertiary)]',
};

const aspectRatio = coverWidth && coverHeight ? coverWidth / coverHeight : 2 / 3;
const isHorizontal = aspectRatio > 1.15;
const activeVariant = variant || (isHorizontal ? 'horizontal' : 'split-left');

// Dimensions for split-left and split-right cards (taller cover: 148px)
const SPLIT_HEIGHT = 148;
const splitWidthPx = Math.min(108, Math.round(SPLIT_HEIGHT * aspectRatio));
const splitWidth = `${splitWidthPx}px`;
const splitHeight = `${SPLIT_HEIGHT}px`;
---

{/* 1. HORIZONTAL COVER VARIANT (Top-Left in user sketch) */}
{activeVariant === 'horizontal' && (
  <article
    class:list={[
      'bento-book bento-book--horizontal group relative mx-auto flex w-full max-w-[360px] flex-col justify-between overflow-hidden rounded-[20px] bg-[var(--surface)] p-3.5 transition-all duration-300 hover:z-20 hover:bg-[var(--surface-hover)]',
      isFinished && 'opacity-75',
    ]}
    data-status={statusLower}
    data-category={category}
  >
    {coverImage ? (
      <div class="relative w-full overflow-hidden rounded-[12px] border border-[var(--line)] shadow-xs aspect-[16/10] bg-[var(--surface-hover)]">
        <img
          src={coverImage}
          alt={title || 'Cover image'}
          loading="lazy"
          class="h-full w-full object-cover block transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />
        <span
          class:list={[
            'absolute top-2.5 left-2.5 rounded px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider border shadow-xs backdrop-blur-md',
            badgeStyles[config.badgeColor],
          ]}
        >
          {status || 'Playing'}
        </span>
      </div>
    ) : (
      <div class="flex aspect-[16/10] w-full items-center justify-center rounded-[12px] border border-[var(--line)] bg-[var(--surface-hover)] shadow-xs">
        <span class="text-[28px]">🎮</span>
      </div>
    )}

    {/* Bottom: Title — Author centered */}
    <div class="mt-3 flex items-center justify-center gap-2 px-2 text-center">
      <p class="font-serif text-[15px] sm:text-[16px] leading-tight text-[var(--ink)] truncate max-w-[65%]">
        {title || 'Untitled'}
      </p>
      {author && (
        <>
          <span class="font-serif text-[12px] text-[var(--ink-tertiary)] opacity-60 shrink-0">—</span>
          <p class="font-serif italic text-[13px] sm:text-[14px] text-[var(--ink-secondary)] truncate max-w-[35%]">
            {author}
          </p>
        </>
      )}
    </div>
  </article>
)}

{/* 2. SPLIT-LEFT VARIANT (Top-Right in user sketch: Cover Left, Status top-right, Title/Author bottom-right) */}
{activeVariant === 'split-left' && (
  <article
    class:list={[
      'bento-book bento-book--split-left group relative mx-auto flex min-h-[190px] w-full max-w-[360px] shrink-0 items-center gap-4 overflow-visible rounded-[20px] bg-[var(--surface)] p-4 transition-all duration-300 hover:z-20 hover:bg-[var(--surface-hover)]',
      isFinished && 'opacity-75',
    ]}
    data-status={statusLower}
    data-category={category}
  >
    {coverImage ? (
      <div
        class="relative shrink-0 overflow-hidden rounded-[8px] border border-[var(--line)] shadow-xs transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        style={`width: ${splitWidth}; height: ${splitHeight};`}
      >
        <img
          src={coverImage}
          alt={title || 'Cover image'}
          loading="lazy"
          class="h-full w-full object-cover block"
        />
      </div>
    ) : (
      <div
        class="flex shrink-0 items-center justify-center rounded-[8px] border border-[var(--line)] bg-[var(--surface-hover)] shadow-xs"
        style={`width: ${splitWidth}; height: ${splitHeight};`}
      >
        <span class="text-[24px]">📖</span>
      </div>
    )}

    <div class="flex min-w-0 flex-1 flex-col justify-between h-[148px] py-0.5">
      <div class="flex justify-end">
        <span
          class:list={[
            'inline-block w-fit rounded px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider border',
            badgeStyles[config.badgeColor],
          ]}
        >
          {status || 'Reading'}
        </span>
      </div>
      <div class="flex flex-col gap-1">
        <p class="font-serif line-clamp-2 text-[16px] leading-snug text-[var(--ink)]">
          {title || 'Untitled'}
        </p>
        <p class="truncate font-serif italic text-[13px] text-[var(--ink-secondary)]">
          {author || 'check back soon ~'}
        </p>
      </div>
    </div>
  </article>
)}

{/* 3. SPLIT-RIGHT VARIANT (Bottom-Left in user sketch: Status top-left, Title/Author bottom-left, Cover Right) */}
{activeVariant === 'split-right' && (
  <article
    class:list={[
      'bento-book bento-book--split-right group relative mx-auto flex min-h-[190px] w-full max-w-[360px] shrink-0 items-center gap-4 overflow-visible rounded-[20px] bg-[var(--surface)] p-4 transition-all duration-300 hover:z-20 hover:bg-[var(--surface-hover)]',
      isFinished && 'opacity-75',
    ]}
    data-status={statusLower}
    data-category={category}
  >
    <div class="flex min-w-0 flex-1 flex-col justify-between h-[148px] py-0.5">
      <div>
        <span
          class:list={[
            'inline-block w-fit rounded px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider border',
            badgeStyles[config.badgeColor],
          ]}
        >
          {status || 'Reading'}
        </span>
      </div>
      <div class="flex flex-col gap-1">
        <p class="font-serif line-clamp-2 text-[16px] leading-snug text-[var(--ink)]">
          {title || 'Untitled'}
        </p>
        <p class="truncate font-serif italic text-[13px] text-[var(--ink-secondary)]">
          {author || 'check back soon ~'}
        </p>
      </div>
    </div>

    {coverImage ? (
      <div
        class="relative shrink-0 overflow-hidden rounded-[8px] border border-[var(--line)] shadow-xs transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        style={`width: ${splitWidth}; height: ${splitHeight};`}
      >
        <img
          src={coverImage}
          alt={title || 'Cover image'}
          loading="lazy"
          class="h-full w-full object-cover block"
        />
      </div>
    ) : (
      <div
        class="flex shrink-0 items-center justify-center rounded-[8px] border border-[var(--line)] bg-[var(--surface-hover)] shadow-xs"
        style={`width: ${splitWidth}; height: ${splitHeight};`}
      >
        <span class="text-[24px]">📖</span>
      </div>
    )}
  </article>
)}

{/* 4. VERTICAL-TALL VARIANT (Bottom-Right in user sketch / Pic 2: Taller card, little space on left & right) */}
{activeVariant === 'vertical-tall' && (
  <article
    class:list={[
      'bento-book bento-book--tall group relative mx-auto flex w-full max-w-[270px] flex-col items-center justify-between overflow-hidden rounded-[20px] bg-[var(--surface)] p-3.5 sm:p-4 transition-all duration-300 hover:z-20 hover:bg-[var(--surface-hover)]',
      isFinished && 'opacity-75',
    ]}
    data-status={statusLower}
    data-category={category}
  >
    <div class="relative w-full flex items-center justify-center pt-0.5">
      {coverImage ? (
        <div
          class="relative w-full overflow-hidden rounded-[10px] border border-[var(--line)] shadow-sm transition-transform duration-500 ease-out group-hover:scale-[1.02]"
          style={`aspect-ratio: ${aspectRatio}; max-height: 380px;`}
        >
          <img
            src={coverImage}
            alt={title || 'Cover image'}
            loading="lazy"
            class="h-full w-full object-cover block"
          />
          <span
            class:list={[
              'absolute top-2.5 left-2.5 rounded px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider border shadow-xs backdrop-blur-md',
              badgeStyles[config.badgeColor],
            ]}
          >
            {status || 'Reading'}
          </span>
        </div>
      ) : (
        <div
          class="flex aspect-[2/3] w-full items-center justify-center rounded-[10px] border border-[var(--line)] bg-[var(--surface-hover)] shadow-xs"
        >
          <span class="text-[36px]">📖</span>
        </div>
      )}
    </div>

    {/* Bottom: Title and Author stacked & centered */}
    <div class="mt-3 flex flex-col items-center text-center w-full px-1">
      <p class="font-serif line-clamp-1 text-[16px] leading-snug text-[var(--ink)]">
        {title || 'Untitled'}
      </p>
      <p class="font-serif italic text-[13px] text-[var(--ink-secondary)] truncate w-full mt-0.5">
        {author || 'check back soon ~'}
      </p>
    </div>
  </article>
)}