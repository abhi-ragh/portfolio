---
/**
 * DitherBand.astro
 * Reusable 1-bit dither transition band.
 * Drop between any two sections as a textural horizontal rule.
 *
 * Props:
 *   density: 'sparse' | 'mid' | 'dense'  (default: 'mid')
 *   height:  number in px                 (default: 32)
 *
 * Usage:
 *   <DitherBand density="sparse" />
 *   <DitherBand density="dense" height={48} />
 */

interface Props {
  density?: 'sparse' | 'mid' | 'dense';
  height?: number;
}

const { density = 'mid', height = 32 } = Astro.props;

/**
 * 4×4 ordered Bayer matrix threshold values (0–15).
 * Standard Bayer pattern — gives smooth, print-like dithering.
 *
 *  0  8  2 10
 * 12  4 14  6
 *  3 11  1  9
 * 15  7 13  5
 *
 * A cell is FILLED if its Bayer value < threshold.
 * sparse:  threshold 4  → ~25% fill (4/16 cells)
 * mid:     threshold 8  → ~50% fill (8/16 cells)
 * dense:   threshold 12 → ~75% fill (12/16 cells)
 */

const BAYER_4X4 = [
  [ 0,  8,  2, 10],
  [12,  4, 14,  6],
  [ 3, 11,  1,  9],
  [15,  7, 13,  5],
];

const THRESHOLDS = { sparse: 4, mid: 8, dense: 12 };
const threshold = THRESHOLDS[density];

// Cell size in px — large enough to be clearly visible on screen
// 4px gives a crisp, intentional dot at normal viewing distance
const CELL = 4;
const PATTERN_SIZE = CELL * 4; // 16px repeating tile

// Build the list of filled cells for this density
const filledCells: { x: number; y: number }[] = [];
for (let row = 0; row < 4; row++) {
  for (let col = 0; col < 4; col++) {
    if (BAYER_4X4[row][col] < threshold) {
      filledCells.push({ x: col * CELL, y: row * CELL });
    }
  }
}

const patternId = `dither-${density}-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="dither-band" style={`height: ${height}px;`} aria-hidden="true">
  <svg
    width="100%"
    height={height}
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="none"
  >
    <defs>
      <pattern
        id={patternId}
        x="0"
        y="0"
        width={PATTERN_SIZE}
        height={PATTERN_SIZE}
        patternUnits="userSpaceOnUse"
      >
        <!-- Pattern background: transparent (shows --bg through) -->
        {filledCells.map(({ x, y }) => (
          <rect
            x={x}
            y={y}
            width={CELL}
            height={CELL}
            fill="var(--dither-fg, #E8E4DC)"
          />
        ))}
      </pattern>
    </defs>
    <rect width="100%" height={height} fill={`url(#${patternId})`} />
  </svg>
</div>

<style>
  .dither-band {
    width: 100%;
    display: block;
    overflow: hidden;
    /* No border — the dither pattern IS the visual separator */
  }
</style>
