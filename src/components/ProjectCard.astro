---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  showMedia?: boolean;
}

const { project, showMedia = true } = Astro.props;
const isExternal = Boolean(project.github);
---

<article class="group relative flex flex-col overflow-hidden rounded-[14px] bg-[var(--surface)] transition-colors duration-200 hover:bg-[var(--surface-hover)]">
  {/* Full-cell clickable link overlay */}
  <a
    href={project.github || '/projects'}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    class="absolute inset-0 z-0"
    aria-label={`View ${project.title}`}
  ></a>

  {/* Header: Category · Title + arrow */}
  <div class="relative z-10 flex shrink-0 items-center justify-between gap-3 px-4 pt-3.5 pb-2.5">
    <div class="flex min-w-0 items-baseline gap-1.5 font-mono text-[10.5px] leading-none">
      <span class="shrink-0 text-[var(--ink-tertiary)]">Project</span>
      <span class="shrink-0 text-[var(--ink-tertiary)] opacity-50">·</span>
      <span class="truncate text-[var(--ink-secondary)] transition-colors group-hover:text-[var(--ink)]">
        {project.title}
      </span>
    </div>
    <span
      class="shrink-0 font-mono text-[11px] leading-none text-[var(--ink-tertiary)] transition-colors group-hover:text-[var(--accent)]"
      aria-hidden="true">↗</span
    >
  </div>

  <div class="relative z-10 flex flex-1 flex-col gap-3 px-4 pb-4">
    {/* Cover image */}
    {showMedia && (
      <div class="w-full overflow-hidden rounded-[9px] bg-[var(--surface-hover)]">
        <div class="aspect-[16/9] w-full overflow-hidden">
          {project.coverImage ? (
            <img
              src={project.coverImage}
              alt={project.title}
              loading="lazy"
              class="block h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center p-4 text-center font-mono text-[10.5px] tracking-[0.04em] text-[var(--ink-tertiary)]">
              {project.title}
            </div>
          )}
        </div>
      </div>
    )}

    {/* Description */}
    {project.description && (
      <p class="font-serif text-[14px] italic leading-[1.7] text-[var(--ink-secondary)] line-clamp-3 sm:text-[15px]">
        {project.description}
      </p>
    )}

    {/* Tags */}
    {project.tags && (
      <p class="mt-auto truncate font-mono text-[9.5px] font-semibold uppercase tracking-[0.08em] text-[var(--ink-tertiary)]">
        {project.tags}
      </p>
    )}
  </div>
</article>
