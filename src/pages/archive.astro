---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import ArchiveGrid from '../components/ArchiveGrid';
import Footer from '../components/Footer.astro';
import { getArchiveImages } from '../lib/archive';

const archiveItems = await getArchiveImages();
---

<Base title="Archive — Complete Collection | abhiragh a r">
  <div class="w-full max-w-[1536px] mx-auto min-h-screen px-6 sm:px-10 lg:px-12 xl:px-16 flex flex-col lg:flex-row gap-2 sm:gap-4 lg:gap-12 xl:gap-16 relative z-10">
    <Sidebar />

    <main class="flex-1 min-w-0 pt-0 pb-8 lg:py-16 px-0 lg:px-4 xl:px-8">
      <div class="w-full max-w-[920px] xl:max-w-[960px] mx-auto flex flex-col gap-12">
        {/* Archive Header Subheading */}
        <div class="pb-2">
          <p class="font-serif italic text-[17px] sm:text-[19px] text-[var(--ink-secondary)] max-w-none leading-relaxed">
            clicks and sketches
          </p>
        </div>

        {/* Editorial Archive Grid */}
        <ArchiveGrid client:load items={archiveItems} />
      </div>

      <Footer />
    </main>
  </div>
</Base>
