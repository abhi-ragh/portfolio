---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  showMedia?: boolean;
}

const { project, showMedia = true } = Astro.props;
const isExternal = Boolean(project.github);
---

<article class="group relative flex flex-col overflow-hidden rounded-[20px] bg-[var(--surface)] transition-all duration-300 hover:bg-[var(--surface-hover)]">
  {/* Full-cell clickable link overlay */}
  <a
    href={project.github || '/projects'}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    class="absolute inset-0 z-0"
    aria-label={`View ${project.title}`}
  ></a>

  {/* Header: Category · Title + arrow (slides open on hover) */}
  <div class="relative z-10 grid shrink-0 transition-all duration-300 ease-out grid-rows-[0fr] opacity-0 group-hover:grid-rows-[1fr] group-hover:opacity-100 group-focus-within:grid-rows-[1fr] group-focus-within:opacity-100">
    <div class="overflow-hidden">
      <div class="flex items-center justify-between gap-3 px-4 pt-3.5 pb-2">
        <div class="flex min-w-0 items-center gap-1.5 font-mono text-[11px] leading-none">
          <span class="shrink-0 text-[var(--ink-tertiary)]">Projects</span>
          <span class="shrink-0 text-[var(--ink-tertiary)] opacity-40">·</span>
          <span class="truncate font-sans font-medium text-[var(--ink-secondary)] transition-colors group-hover:text-[var(--ink)]">
            {project.title}
          </span>
        </div>
        <span
          class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white shadow-xs text-[var(--ink)] text-[12px] leading-none transition-transform duration-200 group-hover:scale-105"
          aria-hidden="true"
        >
          ↗
        </span>
      </div>
    </div>
  </div>

  <div class="relative z-10 flex flex-1 flex-col gap-3 p-4">
    {/* Cover image */}
    {showMedia && (
      <div class="w-full overflow-hidden rounded-[14px] bg-[var(--surface-hover)]">
        <div class="aspect-[16/9] w-full overflow-hidden">
          {project.coverImage ? (
            <img
              src={project.coverImage}
              alt={project.title}
              loading="lazy"
              class="block h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center p-4 text-center font-mono text-[11px] tracking-[0.04em] text-[var(--ink-tertiary)]">
              {project.title}
            </div>
          )}
        </div>
      </div>
    )}

    {/* Description */}
    {project.description && (
      <p class="font-serif text-[14px] italic leading-[1.7] text-[var(--ink-secondary)] line-clamp-3 sm:text-[15px]">
        {project.description}
      </p>
    )}

    {/* Tags */}
    {project.tags && (
      <div class="mt-auto flex flex-wrap gap-1.5 pt-1">
        {project.tags.split('·').map((tag: string) => tag.trim()).filter(Boolean).map((tag: string) => (
          <span class="rounded-full border border-[var(--line)] bg-[var(--surface-hover)] px-2 py-0.5 font-mono text-[9px] uppercase tracking-wider text-[var(--ink-secondary)]">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
