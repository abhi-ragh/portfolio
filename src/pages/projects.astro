---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getArchiveProjects } from '../lib/projects';

let projects = [];
try {
  projects = await getArchiveProjects();
} catch (e) {
  projects = [];
}
---

<Base title="Projects — Selected Engineering Work | abhiragh a r">
  <div class="max-w-[1280px] mx-auto min-h-screen px-6 sm:px-10 lg:px-12 flex flex-col lg:flex-row gap-8 lg:gap-16 relative z-10">
    <Sidebar />

    <main class="flex-1 min-w-0 py-8 lg:py-16 flex flex-col gap-12">
      {/* Header */}
      <div class="flex flex-col gap-4 border-b border-[var(--line)] pb-8">
        <div>
          <span class="accent-hover-bracket inline-block font-mono text-[11px] text-[var(--ink)] tracking-[0.1em] border border-[var(--line)] px-2.5 py-1 select-none bg-[var(--surface)]/80">
            <span class="bracket">[</span> PROJECTS / COLLECTION <span class="bracket">]</span>
          </span>
        </div>
        <h1 class="font-serif text-[32px] md:text-[44px] text-[var(--ink)] font-normal tracking-tight">
          Engineering Projects
        </h1>
        <p class="font-serif italic text-[15px] text-[var(--ink-faint)] max-w-xl leading-relaxed">
          Engineering projects, infrastructure automations, and side projects.
        </p>
      </div>

      {projects.length === 0 ? (
        <div class="font-serif italic text-[18px] text-[var(--ink-faint)] py-8">
          Projects<br />
          Coming soon.
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {projects.map((project) => (
            <ProjectCard project={project} showMedia={true} />
          ))}
        </div>
      )}

      <Footer />
    </main>
  </div>
</Base>
