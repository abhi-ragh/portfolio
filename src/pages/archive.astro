---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ArchiveGrid from '../components/ArchiveGrid';
import { getArchiveImages } from '../lib/archive.ts';

let archiveItems = [];
try {
  archiveItems = await getArchiveImages();
} catch (e) {
  archiveItems = [];
}
---

<Base title="Gallery — abhiragh a r">
  <div class="mx-auto flex min-h-dvh w-full max-w-[1560px] flex-col px-5 pt-6 pb-5 sm:px-8 sm:pt-7 lg:px-12 xl:px-16 lg:pb-7">
    <Nav active="gallery" />

    <main class="mt-8 flex-1 lg:mt-10">
      <div class="mb-8 flex flex-col gap-2 lg:mb-10">
        <h1 class="font-hand text-[42px] font-bold leading-none text-[var(--ink)] sm:text-[52px]">gallery</h1>
        <p class="font-mono text-[11px] tracking-[0.04em] text-[var(--ink-tertiary)]">
          clicks and sketches, outside work hours
        </p>
      </div>

      <ArchiveGrid client:load items={archiveItems} />
    </main>

    <SiteFooter class="mt-10" />
  </div>
</Base>
