---
interface Props {
  title?: string;
  author?: string;
  coverImage?: string;
  status?: string;
  coverFitsGrid?: boolean;
  coverWidth?: number;
  coverHeight?: number;
}

const { title, author, coverImage, status, coverFitsGrid = true, coverWidth, coverHeight } = Astro.props;

const statusLower = (status || '').toLowerCase();
const isFinished = statusLower.startsWith('recently');
const category = isFinished ? 'complete' : 'in-progress';

const statusConfig: Record<string, {
  badgeColor: 'amber' | 'emerald' | 'blue' | 'violet' | 'rose' | 'cyan';
  hoverAnimation: string;
  coverHoverAnimation: string;
  fallbackAnimation: string;
}> = {
  'watching': {
    badgeColor: 'blue',
    hoverAnimation: 'hover:shadow-[0_0_40px_-5px_rgba(59,130,246,0.5)] hover:border-blue-500/30',
    coverHoverAnimation: 'group-hover:scale-[1.18] group-hover:rotate-[1deg] group-hover:shadow-[0_25px_50px_-12px_rgba(59,130,246,0.4)]',
    fallbackAnimation: 'group-hover:scale-[1.02] group-hover:shadow-[0_20px_40px_-10px_rgba(59,130,246,0.3)]',
  },
  'playing': {
    badgeColor: 'violet',
    hoverAnimation: 'hover:shadow-[0_0_40px_-5px_rgba(168,85,247,0.5)] hover:border-violet-500/30',
    coverHoverAnimation: 'group-hover:scale-[1.15] group-hover:-rotate-[1deg] group-hover:shadow-[0_25px_50px_-12px_rgba(168,85,247,0.4)]',
    fallbackAnimation: 'group-hover:scale-[1.02] group-hover:shadow-[0_20px_40px_-10px_rgba(168,85,247,0.3)]',
  },
  'reading': {
    badgeColor: 'amber',
    hoverAnimation: 'hover:shadow-[0_0_40px_-5px_rgba(245,158,11,0.5)] hover:border-amber-500/30',
    coverHoverAnimation: 'group-hover:scale-[1.16] group-hover:shadow-[0_25px_50px_-12px_rgba(245,158,11,0.4)]',
    fallbackAnimation: 'group-hover:scale-[1.02] group-hover:shadow-[0_20px_40px_-10px_rgba(245,158,11,0.3)]',
  },
  'recently watched': {
    badgeColor: 'cyan',
    hoverAnimation: 'hover:shadow-[0_0_30px_-5px_rgba(6,182,212,0.4)] hover:border-cyan-500/30',
    coverHoverAnimation: 'group-hover:scale-[1.12] group-hover:translate-y-[-4px] group-hover:shadow-[0_20px_40px_-10px_rgba(6,182,212,0.35)]',
    fallbackAnimation: 'group-hover:scale-[1.02] group-hover:shadow-[0_15px_30px_-8px_rgba(6,182,212,0.25)]',
  },
  'recently played': {
    badgeColor: 'rose',
    hoverAnimation: 'hover:shadow-[0_0_30px_-5px_rgba(244,63,94,0.4)] hover:border-rose-500/30',
    coverHoverAnimation: 'group-hover:scale-[1.12] group-hover:translate-y-[-4px] group-hover:shadow-[0_20px_40px_-10px_rgba(244,63,94,0.35)]',
    fallbackAnimation: 'group-hover:scale-[1.02] group-hover:shadow-[0_15px_30px_-8px_rgba(244,63,94,0.25)]',
  },
  'recently read': {
    badgeColor: 'emerald',
    hoverAnimation: 'hover:shadow-[0_0_30px_-5px_rgba(16,185,129,0.4)] hover:border-emerald-500/30',
    coverHoverAnimation: 'group-hover:scale-[1.12] group-hover:translate-y-[-4px] group-hover:shadow-[0_20px_40px_-10px_rgba(16,185,129,0.35)]',
    fallbackAnimation: 'group-hover:scale-[1.02] group-hover:shadow-[0_15px_30px_-8px_rgba(16,185,129,0.25)]',
  },
};

const config = statusConfig[statusLower] || statusConfig.reading;

const badgeStyles = {
  amber: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20',
  emerald: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20',
  blue: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20',
  violet: 'bg-violet-500/10 text-violet-600 dark:text-violet-400 border border-violet-500/20',
  cyan: 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20',
  rose: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20',
  neutral: 'bg-[var(--surface-hover)] text-[var(--ink-tertiary)]',
};

const aspectRatio = coverWidth && coverHeight ? coverWidth / coverHeight : 2 / 3;

// Max bounds within the 152px card (card padding is py-3.5)
const MAX_HEIGHT = 112;
const MAX_WIDTH = 135;

let displayWidthPx: number;
let displayHeightPx: number;

if (aspectRatio <= 1) {
  // Portrait / square: scale by height
  displayHeightPx = MAX_HEIGHT;
  displayWidthPx = Math.round(displayHeightPx * aspectRatio);
  if (displayWidthPx > MAX_WIDTH) {
    displayWidthPx = MAX_WIDTH;
    displayHeightPx = Math.round(displayWidthPx / aspectRatio);
  }
} else {
  // Landscape / horizontal: fit within MAX_WIDTH while keeping height balanced
  displayWidthPx = MAX_WIDTH;
  displayHeightPx = Math.round(displayWidthPx / aspectRatio);
  if (displayHeightPx > 85) {
    displayHeightPx = 85;
    displayWidthPx = Math.round(displayHeightPx * aspectRatio);
  }
}

const displayWidth = `${displayWidthPx}px`;
const displayHeight = `${displayHeightPx}px`;
---

<article
  class:list={[
    'bento-book group relative flex h-[152px] shrink-0 items-center gap-4 overflow-visible rounded-[20px] bg-[var(--surface)] px-4 py-3.5 transition-all duration-300 hover:z-20',
    isFinished && 'opacity-75',
  ]}
  data-status={statusLower}
  data-category={category}
>
  {coverImage ? (
    <div
      class="relative shrink-0 overflow-hidden rounded-[8px] border border-[var(--line)] shadow-xs transition-transform duration-500 ease-out group-hover:scale-[1.03]"
      style={`width: ${displayWidth}; height: ${displayHeight};`}
    >
      <img
        src={coverImage}
        alt={title || 'Cover image'}
        loading="lazy"
        class="h-full w-full object-cover block"
      />
    </div>
  ) : (
    <div
      class="flex shrink-0 items-center justify-center rounded-[8px] border border-[var(--line)] bg-[var(--surface-hover)] shadow-xs transition-transform duration-500 ease-out group-hover:scale-[1.03]"
      style={`width: ${displayWidth}; height: ${displayHeight};`}
    >
      <span class="text-[24px]">🎮</span>
    </div>
  )}

  <div class="flex min-w-0 flex-1 flex-col gap-1.5">
    <span
      class:list={[
        'inline-block w-fit rounded px-1.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider border',
        badgeStyles[config.badgeColor],
      ]}
    >
      {status || 'Reading'}
    </span>
    <p class="font-serif line-clamp-2 text-[16px] leading-snug text-[var(--ink)]">
      {title || 'Untitled'}
    </p>
    <p class="truncate font-sans text-[12px] text-[var(--ink-secondary)]">
      {author || 'check back soon ~'}
    </p>
  </div>
</article>