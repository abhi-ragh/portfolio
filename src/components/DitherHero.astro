---
/**
 * DitherHero.astro
 * Hero section with a 1-bit dither fill that fades into the dark canvas.
 *
 * The dither is DENSE at the top and fades to nothing via an SVG mask
 * using a vertical linear gradient. Below the fade, the hero text sits
 * on the plain dark background — no texture, clean contrast.
 *
 * The dither here uses a larger cell size (5px) so it reads clearly
 * as an intentional textural element from normal viewing distance.
 */

// Hero text is slotted in — keeps this component reusable
---

<section class="dither-hero" aria-label="Hero">
  <div class="dither-fill" aria-hidden="true">
    <svg
      class="dither-svg"
      xmlns="http://www.w3.org/2000/svg"
      width="100%"
      height="100%"
      preserveAspectRatio="xMidYMid slice"
    >
      <defs>
        <!--
          5×5 cell Bayer-style dense dither pattern.
          Dense fill (~75%) — uses the standard 4×4 Bayer matrix
          with 5px cells for hero-scale visibility.
        -->
        <pattern
          id="hero-dither-pattern"
          x="0"
          y="0"
          width="20"
          height="20"
          patternUnits="userSpaceOnUse"
        >
          <!--
            4×4 Bayer matrix, threshold 12 (dense: 12/16 cells filled)
            Filled cells at threshold < 12:
            (0,0)=0  (2,0)=2  (1,0)=8→NO  (3,0)=10→NO
            Row 0: cells [0,2] filled → x=0,x=10
            Row 1: cells [0,1,2,3] = 12(NO),4,14(NO),6 → x=5
            Row 2: cells [0,1,2,3] = 3,11(NO),1,9(NO) → x=0,x=10
            Row 3: cells [0,1,2,3] = 15(NO),7,13(NO),5 → x=5

            Bayer 4x4 matrix (row, col):
             0  8  2 10
            12  4 14  6
             3 11  1  9
            15  7 13  5

            Dense threshold=12: fill if value < 12
            Row 0: 0✓ 8✓ 2✓ 10✓  → all 4
            Row 1: 12✗ 4✓ 14✗ 6✓ → col 1,3
            Row 2: 3✓ 11✓ 1✓ 9✓  → all 4
            Row 3: 15✗ 7✓ 13✗ 5✓ → col 1,3
          -->
          <!-- Row 0: all 4 cols -->
          <rect x="0"  y="0"  width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <rect x="5"  y="0"  width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <rect x="10" y="0"  width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <rect x="15" y="0"  width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <!-- Row 1: cols 1,3 -->
          <rect x="5"  y="5"  width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <rect x="15" y="5"  width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <!-- Row 2: all 4 cols -->
          <rect x="0"  y="10" width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <rect x="5"  y="10" width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <rect x="10" y="10" width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <rect x="15" y="10" width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <!-- Row 3: cols 1,3 -->
          <rect x="5"  y="15" width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
          <rect x="15" y="15" width="5" height="5" fill="var(--dither-fg, #1C1A17)" />
        </pattern>

        <!--
          Vertical gradient mask: opaque at top, transparent at bottom.
          The gradient starts fading at 30% and is fully transparent by 85%.
          This gives a long, gradual dissolve — not a sharp cut.
        -->
        <linearGradient id="hero-fade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="white" stop-opacity="1" />
          <stop offset="30%"  stop-color="white" stop-opacity="1" />
          <stop offset="85%"  stop-color="white" stop-opacity="0" />
          <stop offset="100%" stop-color="white" stop-opacity="0" />
        </linearGradient>

        <!--
          The mask applies the gradient to the dither fill rect,
          making the pattern fade out from 30% to 85% down the hero.
        -->
        <mask id="hero-dither-mask">
          <rect width="100%" height="100%" fill="url(#hero-fade)" />
        </mask>
      </defs>

      <!-- The dither fill rect, masked to fade downward -->
      <rect
        width="100%"
        height="100%"
        fill="url(#hero-dither-pattern)"
        mask="url(#hero-dither-mask)"
      />
    </svg>
  </div>

  <!-- Text content slot — position below the fade zone -->
  <div class="hero-content">
    <slot />
  </div>
</section>

<style>
  .dither-hero {
    position: relative;
    width: 100%;
    min-height: 70vh;
    background: var(--bg, #F5F0E8);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }

  .dither-fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .dither-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 0 2.5rem 3rem;
  }

  @media (max-width: 768px) {
    .hero-content {
      padding: 0 1.25rem 2rem;
    }
  }
</style>
