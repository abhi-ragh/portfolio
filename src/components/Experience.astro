---
---
<section id="experience" class="relative w-full px-6 md:px-10 pt-[2.5rem] pb-[3rem] border-b border-[var(--rule)] overflow-hidden">
  <!-- Oversized Background Number 02 -->
  <span class="section-bg-number" aria-hidden="true">02</span>

  <div class="relative z-10 w-full flex flex-col">
    <!-- Section Label -->
    <div>
      <span class="accent-hover-bracket inline-block font-mono text-[10px] text-[var(--ink-faint)] tracking-[0.1em] border border-[var(--ink-faint)] px-2 py-0.5 select-none bg-[#12110E]/80 uppercase">
        <span class="bracket">[</span> 02 / EXPERIENCE <span class="bracket">]</span>
      </span>
    </div>

    <!-- Experience Grid (240px 1fr with 0.5px border-right rule on left column) -->
    <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-0 mt-[1.5rem]">
      <!-- Left Column: Employer Name, Location, Date -->
      <div class="md:pr-[2rem] md:border-r border-[var(--rule)] pb-4 md:pb-0">
        <div class="font-serif text-[22px] font-normal text-[var(--ink)] mt-[1.2rem] mb-[0.3rem]">
          Saints & Masters
        </div>
        <div class="font-mono text-[10px] text-[var(--ink-faint)] tracking-[0.08em] uppercase">
          KOCHI, KERALA
        </div>
        <div class="font-mono text-[10px] text-[var(--ink-faint)] tracking-[0.08em] uppercase mt-[0.25rem]">
          MAY 2026 &mdash; PRESENT
        </div>
      </div>

      <!-- Right Column: Role Title, Body, Tech Tags, Link -->
      <div class="md:pl-[2rem] flex flex-col">
        <!-- Role Title (Lora italic 18px) -->
        <div class="font-serif italic text-[18px] text-[var(--ink)] mt-2 md:mt-[1.2rem] mb-[0.8rem]">
          Junior Engineer &mdash; Cloud
        </div>

        <!-- Body Description -->
        <div class="font-serif text-[14px] leading-[1.8] text-[var(--ink-muted)] mb-[1.2rem]">
          Managing AWS environments, infrastructure-as-code automation, and Linux reliability for MSP clients. Focus on quiet precision, pipeline predictability, and automation.
        </div>

        <!-- Tech Tags -->
        <div class="flex flex-wrap gap-[6px] mb-[1.2rem]">
          {["AWS", "Terraform", "Python", "Linux", "Docker", "GitLab CI/CD"].map((skill) => (
            <span class="tech-tag font-mono text-[9px] text-[var(--ink-faint)] border border-[var(--ink-faint)] px-[8px] py-[3px] tracking-[0.06em] uppercase select-none">
              {skill}
            </span>
          ))}
        </div>

        <!-- Link -->
        <div>
          <a
            href="https://linkedin.com/in/abhiragh"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[10px] text-[var(--accent)] tracking-[0.06em] hover:underline"
          >
            Full experience &rarr; linkedin.com/in/abhiragh
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
