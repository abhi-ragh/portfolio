---
interface Props {
  bio?: string;
  items: { task: string; description: string }[];
  stack?: { category: string; tools: string }[];
}

const {
  bio = "Cloud Engineer, Linux enthusiast, your avg nerd, and friendly neighbourhood IT guy, Surviving the tech, Arguing with ChatGPT and trying to find PEACE.",
  items,
  stack = [
    { category: 'CLOUD & INFRA', tools: 'AWS · Azure · Terraform · Docker' },
    { category: 'DEVOPS & CI/CD', tools: 'GitHub Actions · GitLab CI · ArgoCD · Git' },
    { category: 'SYSTEMS & ADMIN', tools: 'Linux · Windows Server · Bash · SQL' },
    { category: 'MONITORING & DEV', tools: 'Grafana · Prometheus · Python · CI/CD' }
  ]
} = Astro.props;
---

<section class="w-full px-6 md:px-10 py-12 md:py-16 bg-[#F5F0E8] border-b border-[var(--rule)] overflow-hidden" id="about">
  <div class="w-full flex flex-col gap-6">
    {/* Row 1: Section Headers on exact same horizontal line (ABOUT | STACK | NOW) */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-10 lg:gap-12 items-center">
      <div>
        <span class="accent-hover-bracket inline-block font-mono text-[10px] leading-none text-[var(--ink-faint)] tracking-[0.1em] border border-[var(--ink-faint)] px-2 py-1 select-none">
          <span class="bracket">[</span> ABOUT <span class="bracket">]</span>
        </span>
      </div>
      <div>
        <span class="accent-hover-bracket inline-block font-mono text-[10px] leading-none text-[var(--ink-faint)] tracking-[0.1em] border border-[var(--ink-faint)] px-2 py-1 select-none">
          <span class="bracket">[</span> STACK <span class="bracket">]</span>
        </span>
      </div>
      <div>
        <span class="accent-hover-bracket inline-block font-mono text-[10px] leading-none text-[var(--ink-faint)] tracking-[0.1em] border border-[var(--ink-faint)] px-2 py-1 select-none">
          <span class="bracket">[</span> NOW <span class="bracket">]</span>
        </span>
      </div>
    </div>

    {/* Row 2: Content (About, STACK, NOW) starting at identical top alignment */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-10 lg:gap-12 items-start">
      {/* Column 1: ABOUT Bio */}
      <div>
        <p class="font-serif text-[15px] sm:text-[16px] md:text-[17px] text-[var(--ink)] leading-[1.65] font-normal">
          {bio}
        </p>
      </div>

      {/* Column 2: STACK Table */}
      <div class="flex flex-col w-full">
        {stack.map(row => (
          <div class="grid grid-cols-[115px_1fr] sm:grid-cols-[130px_1fr] gap-3 items-baseline py-2.5 border-t border-[var(--rule)] last:border-b">
            <span class="font-mono text-[10px] text-[var(--ink-faint)] tracking-[0.08em] uppercase font-medium">
              {row.category}
            </span>
            <span class="font-serif text-[14px] sm:text-[15px] text-[var(--ink)] leading-snug">
              {row.tools}
            </span>
          </div>
        ))}
      </div>

      {/* Column 3: NOW Table */}
      <div class="flex flex-col w-full">
        {items.map(item => (
          <div class="grid grid-cols-[100px_1fr] sm:grid-cols-[120px_1fr] gap-3 items-baseline py-2.5 border-t border-[var(--rule)] last:border-b">
            <span class="font-mono text-[10px] text-[var(--ink-faint)] tracking-[0.08em] uppercase font-medium">
              {item.task}
            </span>
            <span class="font-serif text-[14px] sm:text-[15px] text-[var(--ink)] leading-snug">
              {item.description}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
