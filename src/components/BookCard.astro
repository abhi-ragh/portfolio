---
interface Props {
  title?: string;
  author?: string;
  coverImage?: string;
  status?: string;
  coverWidth?: number;
  coverHeight?: number;
  variant?: 'horizontal' | 'split-left' | 'split-right' | 'vertical-tall';
}

const {
  title,
  author,
  coverImage,
  status,
  coverWidth,
  coverHeight,
  variant,
} = Astro.props;

const statusLower = (status || '').toLowerCase();
const isFinished = statusLower.startsWith('recently');
const category = isFinished ? 'complete' : 'in-progress';

const statusConfig: Record<string, {
  badgeColor: 'amber' | 'emerald' | 'blue' | 'violet' | 'rose' | 'cyan';
}> = {
  'watching': { badgeColor: 'blue' },
  'playing': { badgeColor: 'violet' },
  'reading': { badgeColor: 'amber' },
  'recently watched': { badgeColor: 'cyan' },
  'recently played': { badgeColor: 'rose' },
  'recently read': { badgeColor: 'emerald' },
};

const config = statusConfig[statusLower] || statusConfig.reading;

const badgeStyles = {
  amber: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20',
  emerald: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20',
  blue: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20',
  violet: 'bg-violet-500/10 text-violet-600 dark:text-violet-400 border border-violet-500/20',
  cyan: 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20',
  rose: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20',
  neutral: 'bg-[var(--surface-hover)] text-[var(--ink-tertiary)]',
};

const aspectRatio = coverWidth && coverHeight ? coverWidth / coverHeight : 2 / 3;
const isHorizontal = aspectRatio > 1.15;
const activeVariant = variant || (isHorizontal ? 'horizontal' : 'split-left');

// No title → render the card as image only, with no reserved title space
const hasTitle = Boolean(title && title.trim());

// Dimensions for split-left and split-right cards
const SPLIT_HEIGHT = 164;
const splitWidthPx = Math.min(125, Math.round(SPLIT_HEIGHT * aspectRatio));
const splitWidth = `${splitWidthPx}px`;
const splitHeight = `${SPLIT_HEIGHT}px`;
---

{/* 1. HORIZONTAL COVER VARIANT */}
{activeVariant === 'horizontal' && (
  <article
    class:list={[
      'bento-book bento-book--horizontal group relative flex w-full flex-col justify-between overflow-hidden rounded-[20px] bg-[var(--surface)] p-4 transition-all duration-300 hover:z-20 hover:bg-[var(--surface-hover)]',
      isFinished && 'opacity-85',
    ]}
    data-status={statusLower}
    data-category={category}
  >
    {/* Ambient cover glow */}
    {coverImage && (
      <div
        class="pointer-events-none absolute -right-8 -bottom-8 h-48 w-48 rounded-full opacity-15 blur-3xl transition-opacity duration-500 group-hover:opacity-25"
        style={`background-image: url('${coverImage}'); background-size: cover;`}
        aria-hidden="true"
      />
    )}

    {coverImage ? (
      <div
        class="relative z-10 w-full overflow-hidden rounded-[12px] shadow-xs bg-[var(--surface-hover)]"
        style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : 'aspect-ratio: 16/10;'}
      >
        <img
          src={coverImage}
          alt={title || 'Cover image'}
          loading="lazy"
          class="h-full w-full object-cover block transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />
        <span
          class:list={[
            'absolute top-2.5 left-2.5 inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider border shadow-xs backdrop-blur-md',
            badgeStyles[config.badgeColor],
          ]}
        >
          <span class="h-1.5 w-1.5 rounded-full bg-current opacity-80"></span>
          {status || 'Playing'}
        </span>
      </div>
    ) : (
      <div class="relative z-10 flex aspect-[16/10] w-full items-center justify-center rounded-[12px] bg-[var(--surface-hover)] shadow-xs">
        <span class="text-[28px]">🎮</span>
      </div>
    )}

    {/* Bottom: Title — Author */}
    {hasTitle && (
      <div class="relative z-10 mt-3 flex items-center justify-center gap-2 px-2 text-center">
        <p class="font-serif text-[16px] sm:text-[17px] font-normal leading-tight text-[var(--ink)] truncate max-w-[65%]">
          {title}
        </p>
        {author && (
          <>
            <span class="font-serif text-[12px] text-[var(--ink-tertiary)] opacity-60 shrink-0">—</span>
            <p class="font-serif italic text-[13.5px] text-[var(--ink-secondary)] truncate max-w-[35%]">
              {author}
            </p>
          </>
        )}
      </div>
    )}
  </article>
)}

{/* 2. SPLIT-LEFT VARIANT (Top-Right in user sketch: Cover Left, Status top-right, Title/Author bottom-right) */}
{activeVariant === 'split-left' && (
  <article
    class:list={[
      'bento-book bento-book--split-left group relative flex min-h-[196px] w-full shrink-0 items-center gap-5 overflow-hidden rounded-[20px] bg-[var(--surface)] p-4 sm:p-5 transition-all duration-300 hover:z-20 hover:bg-[var(--surface-hover)]',
      isFinished && 'opacity-85',
    ]}
    data-status={statusLower}
    data-category={category}
  >
    {/* Ambient cover glow */}
    {coverImage && (
      <div
        class="pointer-events-none absolute -right-8 -bottom-8 h-48 w-48 rounded-full opacity-15 blur-3xl transition-opacity duration-500 group-hover:opacity-30"
        style={`background-image: url('${coverImage}'); background-size: cover;`}
        aria-hidden="true"
      />
    )}

    {coverImage ? (
      <div
        class="relative shrink-0 overflow-hidden rounded-[10px] shadow-md shadow-black/10 transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        style={`width: ${splitWidth}; height: ${splitHeight};`}
      >
        <img
          src={coverImage}
          alt={title || 'Cover image'}
          loading="lazy"
          class="h-full w-full object-cover block"
        />
      </div>
    ) : (
      <div
        class="flex shrink-0 items-center justify-center rounded-[10px] bg-[var(--surface-hover)] shadow-xs"
        style={`width: ${splitWidth}; height: ${splitHeight};`}
      >
        <span class="text-[28px]">📖</span>
      </div>
    )}

    {hasTitle && (
      <div class="relative z-10 flex min-w-0 flex-1 flex-col justify-center gap-2">
        <div class="flex items-center gap-2">
          <span
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-[9.5px] font-semibold uppercase tracking-wider border backdrop-blur-sm shadow-2xs',
              badgeStyles[config.badgeColor],
            ]}
          >
            <span class="h-1.5 w-1.5 rounded-full bg-current opacity-80"></span>
            {status || 'Reading'}
          </span>
        </div>
        <div class="flex flex-col gap-1">
          <h4 class="font-serif text-[18px] sm:text-[20px] font-normal leading-snug tracking-tight text-[var(--ink)] line-clamp-2">
            {title}
          </h4>
          {author && (
            <p class="font-serif italic text-[13.5px] sm:text-[14px] text-[var(--ink-secondary)] truncate">
              {author}
            </p>
          )}
        </div>
      </div>
    )}
  </article>
)}

{/* 3. SPLIT-RIGHT VARIANT */}
{activeVariant === 'split-right' && (
  <article
    class:list={[
      'bento-book bento-book--split-right group relative flex min-h-[196px] w-full shrink-0 items-center gap-5 overflow-hidden rounded-[20px] bg-[var(--surface)] p-4 sm:p-5 transition-all duration-300 hover:z-20 hover:bg-[var(--surface-hover)]',
      isFinished && 'opacity-85',
    ]}
    data-status={statusLower}
    data-category={category}
  >
    {/* Ambient cover glow */}
    {coverImage && (
      <div
        class="pointer-events-none absolute -left-8 -bottom-8 h-48 w-48 rounded-full opacity-15 blur-3xl transition-opacity duration-500 group-hover:opacity-30"
        style={`background-image: url('${coverImage}'); background-size: cover;`}
        aria-hidden="true"
      />
    )}

    {hasTitle && (
      <div class="relative z-10 flex min-w-0 flex-1 flex-col justify-center gap-2">
        <div class="flex items-center gap-2">
          <span
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-[9.5px] font-semibold uppercase tracking-wider border backdrop-blur-sm shadow-2xs',
              badgeStyles[config.badgeColor],
            ]}
          >
            <span class="h-1.5 w-1.5 rounded-full bg-current opacity-80"></span>
            {status || 'Reading'}
          </span>
        </div>
        <div class="flex flex-col gap-1">
          <h4 class="font-serif text-[18px] sm:text-[20px] font-normal leading-snug tracking-tight text-[var(--ink)] line-clamp-2">
            {title}
          </h4>
          {author && (
            <p class="font-serif italic text-[13.5px] sm:text-[14px] text-[var(--ink-secondary)] truncate">
              {author}
            </p>
          )}
        </div>
      </div>
    )}

    {coverImage ? (
      <div
        class="relative shrink-0 overflow-hidden rounded-[10px] shadow-md shadow-black/10 transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        style={`width: ${splitWidth}; height: ${splitHeight};`}
      >
        <img
          src={coverImage}
          alt={title || 'Cover image'}
          loading="lazy"
          class="h-full w-full object-cover block"
        />
      </div>
    ) : (
      <div
        class="flex shrink-0 items-center justify-center rounded-[10px] bg-[var(--surface-hover)] shadow-xs"
        style={`width: ${splitWidth}; height: ${splitHeight};`}
      >
        <span class="text-[28px]">📖</span>
      </div>
    )}
  </article>
)}

{/* 4. VERTICAL-TALL VARIANT */}
{activeVariant === 'vertical-tall' && (
  <article
    class:list={[
      'bento-book bento-book--tall group relative flex w-full flex-col items-center justify-between overflow-hidden rounded-[20px] bg-[var(--surface)] p-5 transition-all duration-300 hover:z-20 hover:bg-[var(--surface-hover)]',
      isFinished && 'opacity-85',
    ]}
    data-status={statusLower}
    data-category={category}
  >
    {/* Ambient cover glow */}
    {coverImage && (
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden opacity-15 transition-opacity duration-500 group-hover:opacity-25"
        aria-hidden="true"
      >
        <img
          src={coverImage}
          alt=""
          class="h-full w-full object-cover blur-2xl scale-125"
        />
      </div>
    )}

    {/* Top Header: Badge */}
    <div class="relative z-10 flex w-full justify-between items-center mb-2">
      <span
        class:list={[
          'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-[9.5px] font-semibold uppercase tracking-wider border backdrop-blur-sm shadow-2xs',
          badgeStyles[config.badgeColor],
        ]}
      >
        <span class="h-1.5 w-1.5 rounded-full bg-current opacity-80"></span>
        {status || 'Reading'}
      </span>
    </div>

    {/* Center: Book Cover with realistic drop-shadow */}
    <div class="relative z-10 flex w-full items-center justify-center py-2">
      {coverImage ? (
        <div
          class="relative w-auto max-w-[260px] overflow-hidden rounded-[10px] shadow-lg shadow-black/15 transition-transform duration-500 ease-out group-hover:scale-[1.03]"
          style={aspectRatio ? `aspect-ratio: ${aspectRatio}; max-height: 280px;` : 'aspect-ratio: 2/3; max-height: 280px;'}
        >
          <img
            src={coverImage}
            alt={title || 'Cover image'}
            loading="lazy"
            class="h-full w-full object-contain block"
          />
        </div>
      ) : (
        <div
          class="flex aspect-[2/3] w-[180px] items-center justify-center rounded-[10px] bg-[var(--surface-hover)] shadow-xs"
        >
          <span class="text-[36px]">📖</span>
        </div>
      )}
    </div>

    {/* Bottom: Title and Author */}
    {hasTitle && (
      <div class="relative z-10 mt-2 flex flex-col items-center text-center w-full px-2">
        <h4 class="font-serif text-[18px] sm:text-[20px] font-normal leading-snug tracking-tight text-[var(--ink)] line-clamp-1">
          {title}
        </h4>
        {author && (
          <p class="font-serif italic text-[13.5px] sm:text-[14px] text-[var(--ink-secondary)] truncate w-full mt-0.5">
            {author}
          </p>
        )}
      </div>
    )}
  </article>
)}
