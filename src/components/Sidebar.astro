---
interface Props {
  activeSection?: string;
}

const { activeSection = '' } = Astro.props;
---

<header class="w-full lg:w-[320px] xl:w-[360px] lg:h-screen lg:sticky lg:top-0 flex flex-col justify-end gap-6 lg:gap-8 py-8 lg:py-16 shrink-0 z-40 border-t lg:border-t-0 lg:border-r border-[var(--line)] lg:pr-8 order-last lg:order-first">
  <!-- Top Block: Identity Stack -->
  <div class="flex flex-col gap-6">
    <!-- Identity Stack in Exact Spec Order -->
    <div class="flex flex-col gap-1.5">
      {/* 1. abhiragh (Handwritten, large & bold) */}
      <a href="/" class="font-hand text-[48px] sm:text-[56px] font-bold text-[var(--ink)] leading-none tracking-tight hover:text-[var(--accent)] transition-colors inline-block select-none">
        abhiragh
      </a>

      {/* 2. Cloud Engineer (Normal type, smaller, directly under name) */}
      <h2 class="font-serif text-[17px] sm:text-[18px] text-[var(--ink)] font-normal leading-snug">
        Cloud Engineer
      </h2>

      {/* 3. One-line tech/identity summary (reusing top tags) */}
      <div class="font-mono text-[11px] text-[var(--ink-faint)] tracking-[0.1em] uppercase font-medium mt-1">
        AWS &middot; Linux &middot; Docker
      </div>

      {/* 4. Kerala, India (Small normal/mono type) */}
      <div class="font-mono text-[11px] text-[var(--ink-faint)] tracking-[0.06em]">
        Kerala, India
      </div>
    </div>

    <!-- 5. Nav Links (Primary Navigation) -->
    <nav class="flex flex-wrap lg:flex-col gap-3 lg:gap-3.5 mt-4 lg:mt-6 font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--ink)]">
      <a
        href="/#experience"
        class="group flex items-center gap-3 hover:text-[var(--accent)] transition-colors py-1"
      >
        <span class="h-[1px] w-5 bg-[var(--ink-faint)] group-hover:w-8 group-hover:bg-[var(--accent)] transition-all hidden lg:inline-block"></span>
        <span>EXPERIENCE</span>
      </a>
      <a
        href="/projects"
        class="group flex items-center gap-3 hover:text-[var(--accent)] transition-colors py-1"
      >
        <span class="h-[1px] w-5 bg-[var(--ink-faint)] group-hover:w-8 group-hover:bg-[var(--accent)] transition-all hidden lg:inline-block"></span>
        <span>PROJECTS</span>
      </a>
      <a
        href="/archive"
        class="group flex items-center gap-3 hover:text-[var(--accent)] transition-colors py-1"
      >
        <span class="h-[1px] w-5 bg-[var(--ink-faint)] group-hover:w-8 group-hover:bg-[var(--accent)] transition-all hidden lg:inline-block"></span>
        <span>COLLECTION</span>
      </a>
      <a
        href="/blogs"
        class="group flex items-center gap-3 hover:text-[var(--accent)] transition-colors py-1"
      >
        <span class="h-[1px] w-5 bg-[var(--ink-faint)] group-hover:w-8 group-hover:bg-[var(--accent)] transition-all hidden lg:inline-block"></span>
        <span>WRITING</span>
      </a>
    </nav>
  </div>

  <!-- 6. Bottom-anchored within column: github, linkedin, email (Plain text links, lowercase) -->
  <div class="flex flex-col gap-2 mt-8 lg:mt-0 font-mono text-[11px] lowercase tracking-[0.08em] text-[var(--ink-faint)]">
    <div class="flex items-center gap-3">
      <a href="https://github.com/abhiragh" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
        github
      </a>
      <span>&middot;</span>
      <a href="https://linkedin.com/in/abhiragh" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors">
        linkedin
      </a>
      <span>&middot;</span>
      <a href="mailto:contact@abhiragh.com" class="hover:text-[var(--ink)] transition-colors">
        email
      </a>
    </div>
  </div>
</header>
