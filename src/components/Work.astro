---
---
<section id="work" class="w-full px-6 md:px-10 py-16 md:py-24 border-b border-[var(--ink-faint)]/40">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
    <!-- Left Column (35% ~ 4 cols out of 12) -->
    <div class="md:col-span-4 flex flex-col gap-6">
      <div>
        <span class="accent-hover-bracket inline-block font-mono text-[11px] text-[var(--ink)] tracking-[0.1em] border border-[var(--ink-faint)] px-2.5 py-1 select-none bg-[#12110E]/80">
          <span class="bracket">[</span> 03 / WORK <span class="bracket">]</span>
        </span>
      </div>

      <div class="font-mono text-[11px] flex flex-col gap-1">
        <span class="text-[var(--ink)] font-medium">saints & masters</span>
        <span class="text-[var(--ink-faint)]">2024 &mdash; present</span>
      </div>
    </div>

    <!-- Right Column (65% ~ 8 cols out of 12) -->
    <div class="md:col-span-8 flex flex-col gap-6">
      <p class="font-serif text-[16px] text-[var(--ink)] leading-[1.85]">
        Currently serving as a DevOps & cloud engineer, managing AWS environments, infrastructure-as-code automation, and Linux server reliability for client systems that cannot afford downtime. Focus centers on quiet precision, pipeline predictability, and automation.
      </p>

      <!-- Tech Tags Row -->
      <div class="flex flex-wrap gap-2.5 mt-2">
        {['AWS', 'Terraform', 'Python', 'Linux', 'Docker', 'GitLab CI/CD'].map((tag) => (
          <span class="tech-tag font-mono text-[11px] text-[var(--ink)] border border-[var(--ink-faint)] px-[10px] py-[4px] select-none cursor-default bg-[#12110E]/80">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
