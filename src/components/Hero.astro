---
import HeroTicker from './HeroTicker.jsx';
import HeroGlyph from './HeroGlyph.jsx';
---
<section class="relative w-full min-h-screen h-[100vh] flex flex-col justify-end pb-[26vh] md:pb-[28vh] z-30 px-6 md:px-10 overflow-hidden">
  <div class="relative z-30 max-w-[1000px] flex flex-col gap-4">
    <h1 class="font-serif text-[46px] sm:text-[60px] md:text-[72px] font-normal leading-[1.06] text-[var(--ink)] tracking-tight">
      infrastructure, film,<br />
      and the space between.
    </h1>

    <div class="font-mono text-[11px] sm:text-[12px] text-[var(--ink-muted)] tracking-[0.12em] uppercase mt-1">
      Lost Somewhere &mdash; 9.9312° N, 76.2673° E
    </div>
  </div>

  {/* Vertical Stack: Tagline -> Ticker (bottom: 3.5rem) -> Glyph (bottom: 1rem) */}
  <HeroTicker client:load />
  <HeroGlyph client:load />
</section>
