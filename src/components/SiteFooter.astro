---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<footer
  class:list={[
    'flex flex-wrap items-center justify-between gap-x-6 gap-y-2 font-mono text-[11px] tracking-[0.02em] text-[var(--ink-tertiary)]',
    className,
  ]}
>
  <p class="flex items-center gap-1.5">
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500/80 animate-pulse"></span>
    <span>built by hand</span>
  </p>
  <div class="flex items-center gap-3">
    <a href="mailto:abhiragh0@gmail.com" class="transition-colors hover:text-[var(--ink)]">email</a>
    <span aria-hidden="true" class="opacity-50">·</span>
    <a
      href="https://www.github.com/abhi-ragh"
      target="_blank"
      rel="noopener noreferrer"
      class="transition-colors hover:text-[var(--ink)]">github</a
    >
    <span aria-hidden="true" class="opacity-50">·</span>
    <a
      href="https://www.linkedin.com/in/abhi-ragh/"
      target="_blank"
      rel="noopener noreferrer"
      class="transition-colors hover:text-[var(--ink)]">linkedin</a
    >
  </div>
</footer>
