---
interface Props {
  category: string;
  title?: string;
  href?: string;
  external?: boolean;
  bodyClass?: string;
  class?: string;
  bare?: boolean;
  reveal?: boolean;
  badge?: string;
  badgeColor?: 'amber' | 'emerald' | 'blue' | 'neutral';
}

const {
  category,
  title,
  href,
  external = false,
  bodyClass = 'px-4 pb-4',
  class: className = '',
  bare = false,
  reveal = true,
  badge,
  badgeColor = 'neutral',
} = Astro.props;

const isLink = Boolean(href);
const Tag = isLink ? 'a' : 'div';
const linkAttrs = isLink
  ? {
      href,
      target: external ? '_blank' : undefined,
      rel: external ? 'noopener noreferrer' : undefined,
    }
  : {};

const badgeStyles = {
  amber: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20',
  emerald: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20',
  blue: 'bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20',
  neutral: 'bg-[var(--surface-hover)] text-[var(--ink-tertiary)]',
};
---

<Tag
  {...linkAttrs}
  class:list={[
    'group relative flex min-h-0 min-w-0 flex-col overflow-hidden rounded-[20px] bg-[var(--surface)] transition-all duration-300',
    isLink && 'hover:bg-[var(--surface-hover)]',
    className,
  ]}
>
  {
    !bare && (
      <div
        class:list={[
          'grid shrink-0 transition-all duration-300 ease-out',
          reveal
            ? 'grid-rows-[0fr] opacity-0 group-hover:grid-rows-[1fr] group-hover:opacity-100 group-focus-visible:grid-rows-[1fr] group-focus-visible:opacity-100'
            : 'grid-rows-[1fr] opacity-100',
        ]}
      >
        <div class="overflow-hidden">
          <div class="flex items-center justify-between gap-2.5 px-3.5 pt-2 pb-1">
            <div class="flex min-w-0 items-center gap-1.5 font-mono text-[10.5px] leading-none">
              <span class="shrink-0 text-[var(--ink-tertiary)]">{category}</span>
              {title && (
                <>
                  <span class="shrink-0 text-[var(--ink-tertiary)] opacity-40">·</span>
                  <span class="truncate font-sans font-medium text-[var(--ink-secondary)] transition-colors group-hover:text-[var(--ink)]">
                    {title}
                  </span>
                </>
              )}
              {badge && (
                <span
                  class:list={[
                    'ml-1 rounded px-1.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider border',
                    badgeStyles[badgeColor],
                  ]}
                >
                  {badge}
                </span>
              )}
            </div>
            {isLink && (
              <span
                class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white shadow-xs text-[var(--ink)] text-[11px] leading-none transition-transform duration-200 group-hover:scale-105"
                aria-hidden="true"
              >
                ↗
              </span>
            )}
          </div>
        </div>
      </div>
    )
  }

  <div class:list={['relative min-h-0 flex-1', bare ? '' : bodyClass]}>
    <slot />
  </div>
</Tag>
