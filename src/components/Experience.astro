---
---
<section id="experience" class="sec-relative w-full px-6 md:px-10 pt-[2.5rem] pb-[3rem] border-b border-[var(--rule)]">
  <!-- Oversized Background Number 02 -->
  <span class="section-bg-number" aria-hidden="true">02</span>

  <div class="relative z-10 w-full flex flex-col gap-6">
    <!-- Section Label -->
    <div>
      <span class="accent-hover-bracket inline-block font-mono text-[10px] text-[var(--ink-faint)] tracking-[0.1em] border border-[var(--ink-faint)] px-2 py-0.5 select-none bg-[#12110E]/80 uppercase">
        <span class="bracket">[</span> 02 / EXPERIENCE <span class="bracket">]</span>
      </span>
    </div>

    <!-- Single Employer Structure (Saints & Masters ONLY) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-start pt-2">
      <!-- Left Column: Company & Location -->
      <div class="md:col-span-4 flex flex-col gap-1">
        <h3 class="font-serif italic text-[20px] text-[var(--ink)] font-normal leading-tight">
          Saints & Masters
        </h3>
        <span class="font-mono text-[11px] text-[var(--ink-faint)]">
          Kochi, Kerala
        </span>
      </div>

      <!-- Right Column: Current Role, Period, Description, Tech Tags & External Link -->
      <div class="md:col-span-8 flex flex-col gap-4">
        <div class="flex flex-wrap justify-between items-baseline gap-2">
          <h4 class="font-serif italic text-[18px] text-[var(--ink)]">
            Junior Engineer &mdash; Cloud
          </h4>
          <span class="font-mono text-[10px] text-[var(--ink-faint)] uppercase tracking-[0.08em]">
            May 2026 &mdash; Present
          </span>
        </div>

        <p class="font-serif text-[15px] text-[var(--ink-muted)] leading-[1.85]">
          Managing AWS environments, infrastructure-as-code automation, and Linux reliability for MSP clients.
        </p>

        <!-- Tech Tags -->
        <div class="flex flex-wrap gap-2 pt-2">
          {["AWS", "Terraform", "Python", "Linux", "Docker"].map((skill) => (
            <span class="tech-tag font-mono text-[10px] text-[var(--ink-faint)] border border-[var(--ink-faint)]/40 px-2.5 py-1 select-none bg-[#12110E]/60 transition-colors">
              {skill}
            </span>
          ))}
        </div>

        <!-- External LinkedIn Link -->
        <div class="pt-4">
          <a
            href="https://linkedin.com/in/abhiragh"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[10px] text-[var(--accent)] hover:underline tracking-[0.08em]"
          >
            Full experience &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
