---
const roles = [
  {
    title: "Junior Engineer — Cloud",
    company: "Saints & Masters",
    date: "May 2026 — Present",
    description: "Building and maintaining AWS infrastructure and CI/CD pipelines for managed service clients.",
    tags: "AWS · Terraform · Docker · GitLab CI/CD · Linux"
  },
  {
    title: "DevOps Intern",
    company: "Saints & Masters",
    date: "Apr 2026",
    description: "Infrastructure automation, deployment pipelines, and Linux system reliability.",
    tags: "Python · Linux · AWS"
  },
  {
    title: "System Engineer Intern",
    company: "Bridge Global",
    date: "Jun 2025 — Dec 2025",
    description: "Internal automation tooling, Linux server administration, and network configuration.",
    tags: "Bash · Networking · Git"
  }
];
---

<section id="experience" class="flex flex-col gap-6 scroll-mt-20">
  {/* Roles Plain Vertical Stack with Subtle Hairline Dividers */}
  <div class="flex flex-col divide-y divide-[var(--line)]/40">
    {roles.map((role, idx) => (
      <div class={`flex flex-col gap-2 ${idx === 0 ? 'pb-6 sm:pb-7 lg:pb-8' : idx === roles.length - 1 ? 'pt-6 sm:pt-7 lg:pt-8' : 'py-6 sm:py-7 lg:py-8'}`}>
        {/* Title */}
        <h3 class="font-serif font-medium text-[19px] sm:text-[21px] text-[var(--ink)] leading-snug">
          {role.title}
        </h3>

        {/* Company & Date Range */}
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] tracking-[0.08em]">
          <span class="uppercase font-semibold text-[var(--ink-secondary)]">{role.company}</span>
          <span class="text-[var(--ink-tertiary)]">&middot;</span>
          <span class="text-[var(--ink-tertiary)]">{role.date}</span>
        </div>

        {/* Single-Sentence Description */}
        <p class="font-serif italic text-[14px] sm:text-[15px] text-[var(--ink-secondary)] leading-relaxed mt-0.5">
          {role.description}
        </p>

        {/* Tech-Tag Line (mono, ·-separated) */}
        <div class="font-mono text-[10px] text-[var(--ink-tertiary)] tracking-[0.08em] uppercase font-semibold mt-1">
          {role.tags}
        </div>
      </div>
    ))}
  </div>

  {/* Full Résumé Link (Inline text treatment) */}
  <div class="pt-1">
    <a
      href="https://linkedin.com/in/abhiragh"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-[11px] font-semibold text-[var(--ink-secondary)] hover:text-[var(--accent)] transition-colors inline-flex items-center gap-1 uppercase tracking-[0.08em]"
    >
      Full r&eacute;sum&eacute; &rarr;
    </a>
  </div>
</section>
