---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import BentoCard from '../components/BentoCard.astro';
import MediaCard from '../components/MediaCard.astro';
import BentoProjectCard from '../components/BentoProjectCard.astro';
import BookCard from '../components/BookCard.astro';
import { getHomepageProjects } from '../lib/projects.ts';
import { getHomepageImages } from '../lib/archive.ts';
import { getHomepageActivities } from '../lib/books.ts';

let featuredProject = null;
let restProjects = [];
let photographs = [];
let sketches = [];
let activities = [];

const GAP = 13.6; // 0.85rem, matches the bento gap

/** Exact intrinsic heights for each card type at column width without resizing or capping */
function cardHeight(item: any, columnWidth: number) {
  if (item.kind === 'project') return 260;
  if (item.kind === 'book') {
    if (item.variant === 'horizontal') {
      const ratio = item.coverWidth && item.coverHeight ? item.coverWidth / item.coverHeight : 1.6;
      return Math.round((columnWidth - 32) / ratio) + 68;
    }
    if (item.variant === 'vertical-tall' || item.variant === 'stack') {
      return 360;
    }
    return 204;
  }
  const ratio = item.width && item.height ? item.width / item.height : 1.5;
  return Math.round(columnWidth / ratio);
}

function orderBucket<T extends { kind: string }>(bucket: T[]): T[] {
  if (bucket.length <= 1) return bucket;
  const result: T[] = [];
  const pool = [...bucket];
  while (pool.length > 0) {
    const last = result[result.length - 1];
    let nextIdx = 0;
    if (last) {
      const diffIdx = pool.findIndex(x => x.kind !== last.kind);
      if (diffIdx !== -1) nextIdx = diffIdx;
    }
    result.push(pool.splice(nextIdx, 1)[0]);
  }
  return result;
}

/**
 * Finds the optimal partition across 3 columns to minimize height differences,
 * ensuring columns stay visually balanced without artificial resizing.
 */
function packItems<T extends { kind: string }>(
  items: T[],
  widths: number[],
  seeds: number[]
): T[][] {
  if (!items.length) return [[], [], []];

  if (items.length <= 11) {
    let bestScore = Infinity;
    let bestAssignment: number[] | null = null;

    function search(idx: number, currentAssignment: number[], currentTotals: number[]) {
      if (idx === items.length) {
        const diff = Math.max(...currentTotals) - Math.min(...currentTotals);
        if (diff < bestScore) {
          bestScore = diff;
          bestAssignment = [...currentAssignment];
        }
        return;
      }
      for (let c = 0; c < 3; c++) {
        currentAssignment[idx] = c;
        const h = cardHeight(items[idx], widths[c]) + GAP;
        currentTotals[c] += h;
        search(idx + 1, currentAssignment, currentTotals);
        currentTotals[c] -= h;
      }
    }

    search(0, new Array(items.length).fill(0), [...seeds]);
    const buckets: T[][] = [[], [], []];
    if (bestAssignment) {
      for (let i = 0; i < items.length; i++) {
        buckets[(bestAssignment as number[])[i]].push(items[i]);
      }
    }
    return buckets.map(b => orderBucket(b));
  }

  // Fast greedy + local search optimization for > 11 items
  const totals = [...seeds];
  const assignment = new Array(items.length).fill(0);
  for (let i = 0; i < items.length; i++) {
    let shortest = 0;
    for (let c = 1; c < 3; c++) {
      if (totals[c] < totals[shortest]) shortest = c;
    }
    assignment[i] = shortest;
    totals[shortest] += cardHeight(items[i], widths[shortest]) + GAP;
  }

  for (let pass = 0; pass < 50; pass++) {
    let improved = false;
    const currentDiff = Math.max(...totals) - Math.min(...totals);

    for (let i = 0; i < items.length; i++) {
      const fromCol = assignment[i];
      const hFrom = cardHeight(items[i], widths[fromCol]) + GAP;

      for (let toCol = 0; toCol < 3; toCol++) {
        if (toCol === fromCol) continue;
        const hTo = cardHeight(items[i], widths[toCol]) + GAP;
        const newTotals = [...totals];
        newTotals[fromCol] -= hFrom;
        newTotals[toCol] += hTo;
        const newDiff = Math.max(...newTotals) - Math.min(...newTotals);

        if (newDiff < currentDiff - 1) {
          totals[fromCol] -= hFrom;
          totals[toCol] += hTo;
          assignment[i] = toCol;
          improved = true;
          break;
        }
      }
      if (improved) break;
    }
    if (!improved) break;
  }

  const buckets: T[][] = [[], [], []];
  for (let i = 0; i < items.length; i++) {
    buckets[assignment[i]].push(items[i]);
  }
  return buckets.map(b => orderBucket(b));
}

try {
  // First ticked project stays the wide featured card in column 3.
  // Any extras are packed by height like the media cards.
  const [featured, ...rest] = await getHomepageProjects();
  featuredProject = featured ?? null;
  restProjects = rest;
} catch (e) {
  console.warn('Failed to fetch homepage projects:', e);
}

try {
  const home = await getHomepageImages();
  photographs = home.photographs.map((item) => ({ ...item, kind: 'photo' as const }));
  sketches = home.sketches.map((item) => ({ ...item, kind: 'sketch' as const }));
} catch (e) {
  console.warn('Failed to fetch homepage images:', e);
}

try {
  // Every activity ticked on the homepage, each showing its own Status.
  // Horizontal covers specifically get 'horizontal'; vertical covers are assigned among the 3 vertical designs.
  const rawActivities = await getHomepageActivities();
  const verticalDesigns = ['split-left', 'split-right', 'vertical-tall'] as const;
  let verticalIdx = 0;

  activities = rawActivities.map((activity) => {
    const aspect = activity.coverWidth && activity.coverHeight
      ? activity.coverWidth / activity.coverHeight
      : 0.67;
    const isHorizontal = aspect > 1.15;
    const variant = (activity.covers?.length ?? 0) >= 2
      ? ('stack' as const)
      : isHorizontal
        ? ('horizontal' as const)
        : verticalDesigns[(verticalIdx++) % verticalDesigns.length];

    return {
      ...activity,
      kind: 'book' as const,
      variant,
    };
  });
} catch (e) {
  console.warn('Failed to fetch homepage activities:', e);
}

// Column widths follow the 1fr 1.1fr 1fr grid.
const COLUMN_RATIOS = [1, 1.1, 1];
const REFERENCE_WIDTH = 1312;
const unit = (REFERENCE_WIDTH - GAP * 2) / COLUMN_RATIOS.reduce((a, b) => a + b, 0);
const columnWidths = COLUMN_RATIOS.map((r) => r * unit);

// Row 1 is the intro + GIF only. Every card starts in row 2, so the
// packing seeds only account for the fixed card at the top of each column:
// Col 1 featured project, Col 2 career, Col 3 music.
const columnSeeds = [
  260 + GAP,
  125 + GAP,
  132 + GAP,
];

const allItems = [
  ...photographs,
  ...sketches,
  ...restProjects.map((project) => ({ ...project, kind: 'project' as const })),
  ...activities,
];

const packed = packItems(allItems, columnWidths, columnSeeds);

const roles = [
  {
    title: 'Junior Engineer — Cloud',
    company: 'Saints & Masters',
    date: 'May 2026 — Present',
  },
  {
    title: 'DevOps Intern',
    company: 'Saints & Masters',
    date: 'Apr 2026',
  },
  {
    title: 'Associate System Engineer Intern',
    company: 'Bridge Global',
    date: 'Jun 2025 — Dec 2025',
  },
];
---

<Base>
  <div class="mx-auto flex min-h-dvh w-full max-w-[1560px] flex-col px-5 pt-6 pb-8 sm:px-8 sm:pt-7 lg:px-12 xl:px-16 lg:pb-7">
    {/* Top bar — nav on the left, socials on the right */}
    <TopBar />

    <main class="bento">
      {/* About — spans the first two columns */}
      <div class="bento-intro mb-12 flex shrink-0 flex-col px-7 pt-8 pb-8 sm:px-10 lg:px-14 lg:pt-8 lg:pb-7">
        <div class="bento-about-text flex h-full flex-col gap-0">
          {/* Row 1 + 2: heading and subtext, left aligned */}
          <div class="shrink-0">
            <h1 class="font-['Caveat'] text-[clamp(40px,4.6vw,66px)] font-semibold leading-none tracking-tight text-[var(--ink)]">
              Hello There!! I'm Abhiragh :)
            </h1>
            <p class="mt-5 font-['Caveat'] text-[clamp(17px,1.9vw,26px)] leading-snug text-[var(--ink)] lg:mt-8">
              <mark>Who am I</mark> is a question I haven't found an answer to <mark>yet,</mark> to put it simply
            </p>
          </div>

          {/* Row 3: one inline row — text, GIF, text, small gaps */}
          <div class="mt-6 flex flex-wrap items-center gap-3 min-[1280px]:flex-nowrap lg:gap-6 lg:mt-4">
            <span class="font-['Caveat'] text-[clamp(18px,1.9vw,27px)] leading-none whitespace-nowrap text-[var(--ink)]">
              I've got a <mark>Computer</mark>
            </span>
            <video
              src="/computer.mp4"
              autoplay
              muted
              loop
              playsinline
              class="h-[84px] w-[160px] shrink-0 rounded-[6px] object-top object-cover lg:h-[108px] lg:w-[206px]"
            ></video>
            <span class="font-['Caveat'] text-[clamp(18px,1.9vw,27px)] leading-none whitespace-nowrap text-[var(--ink)]">
              and I do <mark>silly</mark> things with it.
            </span>
          </div>

          {/* Row 4: coffee + text, then draw text hugging cat — all one line */}
          <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-4 lg:mt-5">
            <div class="flex min-w-0 items-center gap-2">
              <img
                src="/coffee-sleep.jpg"
                alt="Sleepy creature holding coffee"
                class="w-[64px] shrink-0 object-cover mix-blend-multiply lg:h-[78px] lg:w-[68px]"
                loading="lazy"
              />
              <span class="font-['Caveat'] text-[clamp(16px,1.8vw,26px)] leading-tight whitespace-nowrap text-[var(--ink)]">
                Also I run (partially) on <mark>coffee</mark>
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-['Caveat'] text-[clamp(16px,1.8vw,26px)] leading-tight whitespace-nowrap text-[var(--ink)]">
                And I <mark>draw</mark> stuff when I'm <mark>Bored</mark>
              </span>
              <img
                src="/sketch-cat.png"
                alt="Cat chilling in a chair sketch"
                class="w-[80px] shrink-0 mix-blend-multiply lg:w-[76px]"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>

      {/* Hero right: only the GIF sits beside the intro */}
      <div
        class="bento-hello group relative block shrink-0 overflow-hidden rounded-[12px] bg-[var(--surface)] transition-all duration-300 aspect-[480/208] w-full"
        title="Hello there! — Obi-Wan Kenobi"
      >
        <img
          src="/obi-wan-hello-there.gif"
          alt="Obi-Wan Kenobi saying Hello there"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
        />
      </div>

      {/* Column 1: featured project + cards dealt into the shortest column */}
      <div class="bento-col bento-col-1">
        {/* Featured project — starts the grid below the hero */}
        {featuredProject ? (
          <BentoProjectCard
            wide
            title={featuredProject.title}
            coverImage={featuredProject.coverImage}
            github={featuredProject.github}
            category="Featured"
          />
        ) : (
          <div class="bento-project bento-project--wide group relative flex h-[260px] shrink-0 items-center justify-center overflow-hidden rounded-[12px] bg-[var(--surface)] transition-all duration-300">
            <span class="font-mono text-[11px] text-[var(--ink-tertiary)]">no featured project yet ~</span>
          </div>
        )}

        {packed[0].map((item) => (
          item.kind === 'photo' || item.kind === 'sketch' ? (
            <MediaCard
              src={item.imageUrl}
              caption={item.caption}
              width={item.width}
              height={item.height}
              category={item.kind === 'sketch' ? 'Sketch' : undefined}
            />
          ) : item.kind === 'book' ? (
            <BookCard
              title={item.title}
              author={item.author}
              coverImage={item.coverImage}
              covers={item.covers}
              status={item.status}
              coverWidth={item.coverWidth}
              coverHeight={item.coverHeight}
              variant={item.variant}
            />
          ) : (
            <BentoProjectCard
              title={item.title}
              coverImage={item.coverImage}
              github={item.github}
            />
          )
        ))}
      </div>

      {/* Column 2: Career + media */}
      <div class="bento-col bento-col-2">
        {/* Career card — current job & company, skills pop on hover only */}
        <BentoCard
          category="Career"
          href="https://www.linkedin.com/in/abhi-ragh/"
          external
          class="bento-career min-h-[125px] shrink-0"
          reveal
          bodyClass="p-4 sm:p-5 h-full flex flex-col justify-center"
        >
          <div class="flex flex-col justify-center">
            <span class="font-mono text-[9.5px] uppercase tracking-wider text-[var(--ink-tertiary)]">
              Present · Full-time
            </span>
            <h3 class="font-serif text-[17px] sm:text-[18px] font-normal leading-snug text-[var(--ink)] mt-0.5">
              Junior Engineer — Cloud
            </h3>
            <p class="font-serif italic text-[14px] text-[var(--ink-secondary)] mt-0.5">
              Saints & Masters
            </p>
            {/* Skills pop up only when hovered */}
            <div class="mt-2.5 flex flex-wrap gap-1.5 opacity-0 max-h-0 overflow-hidden transition-all duration-300 ease-out group-hover:opacity-100 group-hover:max-h-20">
              {['AWS', 'Azure', 'Kubernetes', 'Terraform', 'Docker', 'Linux'].map((tech) => (
                <span class="rounded-full bg-[var(--surface-hover)] px-2 py-0.5 font-mono text-[9px] uppercase tracking-wider text-[var(--ink-secondary)]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </BentoCard>

        {packed[1].map((item) => (
          item.kind === 'photo' || item.kind === 'sketch' ? (
            <MediaCard
              src={item.imageUrl}
              caption={item.caption}
              width={item.width}
              height={item.height}
              category={item.kind === 'sketch' ? 'Sketch' : undefined}
            />
          ) : item.kind === 'book' ? (
            <BookCard
              title={item.title}
              author={item.author}
              coverImage={item.coverImage}
              covers={item.covers}
              status={item.status}
              coverWidth={item.coverWidth}
              coverHeight={item.coverHeight}
              variant={item.variant}
            />
          ) : (
            <BentoProjectCard
              title={item.title}
              coverImage={item.coverImage}
              github={item.github}
            />
          )
        ))}
      </div>

      {/* Column 3: Music + media */}
      <div class="bento-col bento-col-3">
        {/* Music card — rotating circular vinyl thumbnail matching uploaded screenshot */}
        <BentoCard
          category="Recently played"
          class="bento-music h-[132px] shrink-0 transition-transform duration-300 ease-out hover:z-20 hover:scale-[1.03]"
          reveal
          bodyClass="px-4 py-3 h-full flex items-center"
        >
          <div class="flex w-full min-w-0 items-center gap-5 pl-3">
            <div
              class="relative flex aspect-square h-[68px] w-[68px] shrink-0 items-center justify-center overflow-hidden rounded-full bg-[var(--surface-hover)] shadow-xs transition-all duration-300 ease-out group-hover:h-[84px] group-hover:w-[84px]"
            >
              <img
                id="music-art"
                src=""
                alt=""
                class="hidden h-full w-full object-cover rounded-full animate-[spin_12s_linear_infinite]"
              />
              <span id="music-art-fallback" class="font-serif text-[22px] text-[var(--ink-tertiary)]">♪</span>
            </div>
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
              <div class="flex items-center gap-1.5">
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-mono text-[9px] uppercase tracking-wider text-[var(--ink-tertiary)]">Spotify</span>
              </div>
              <p id="music-track" class="font-serif line-clamp-1 text-[17px] font-medium leading-tight text-[var(--ink)]">
                —
              </p>
              <p id="music-artist" class="truncate font-mono text-[10.5px] text-[var(--ink-secondary)]">
                loading spotify…
              </p>
              {/* Album + year stay hidden until hover */}
              <div class="grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-out group-hover:grid-rows-[1fr] group-hover:opacity-100">
                <div class="overflow-hidden">
                  <p id="music-extra" class="truncate font-mono text-[10px] leading-tight text-[var(--ink-tertiary)]">
                    —
                  </p>
                </div>
              </div>
            </div>
          </div>
        </BentoCard>

        {packed[2].map((item) => (
          item.kind === 'photo' || item.kind === 'sketch' ? (
            <MediaCard
              src={item.imageUrl}
              caption={item.caption}
              width={item.width}
              height={item.height}
              category={item.kind === 'sketch' ? 'Sketch' : undefined}
            />
          ) : item.kind === 'book' ? (
            <BookCard
              title={item.title}
              author={item.author}
              coverImage={item.coverImage}
              covers={item.covers}
              status={item.status}
              coverWidth={item.coverWidth}
              coverHeight={item.coverHeight}
              variant={item.variant}
            />
          ) : (
            <BentoProjectCard
              title={item.title}
              coverImage={item.coverImage}
              github={item.github}
            />
          )
        ))}

        {allItems.length === 0 && (
          <div class="bento-media flex aspect-[3/2] w-full shrink-0 items-center justify-center rounded-[12px] bg-[var(--surface)]">
            <span class="font-mono text-[11px] text-[var(--ink-tertiary)]">no frames yet ~</span>
          </div>
        )}
      </div>
    </main>

  </div>

  <style>
    :global(.bento) {
      display: grid;
      gap: 0.85rem;
      grid-template-columns: 1fr;
    }

    .bento-about-text mark {
      background: #e4e4e4;
      color: var(--ink);
      border-radius: 2px;
      padding: 1px 4px;
    }

    .bento-about-text h1 {
      transform: skewX(12deg);
    }

    @media (max-width: 1023px) {
      :global(.bento-col) {
        display: contents;
      }
      :global(.bento-intro) { order: 1; }
      :global(.bento-hello) { order: 2; }
      :global(.bento-project--wide) { order: 3; min-height: 240px; }
      :global(.bento-career) { order: 4; min-height: 125px; }
      :global(.bento-music) { order: 5; min-height: 132px; }
      :global(.bento-media),
      :global(.bento-book),
      :global(.bento-project:not(.bento-project--wide)) {
        order: 10;
      }
    }

    @media (min-width: 1024px) {
      :global(.bento) {
        grid-template-columns: 1fr 1.1fr 1fr;
        grid-template-rows: auto 1fr;
      }

      :global(.bento-about-text) {
        max-width: 100%;
      }

      :global(.bento-intro) {
        grid-column: 1 / 3;
        grid-row: 1;
        height: auto;
      }

      :global(.bento-hello) {
        grid-column: 3;
        grid-row: 1;
        align-self: start;
      }

      :global(.bento-col-1) { grid-column: 1; grid-row: 2; }
      :global(.bento-col-2) { grid-column: 2; grid-row: 2; }
      :global(.bento-col-3) { grid-column: 3; grid-row: 2; }

      :global(.bento-col) {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }
    }
  </style>

  <script is:inline>
    (function () {
      // ---- Music card: recently played from server endpoint ----
      function initMusic() {
        var trackEl = document.getElementById('music-track');
        var artistEl = document.getElementById('music-artist');
        var artEl = document.getElementById('music-art');
        var fallbackEl = document.getElementById('music-art-fallback');

        fetch('/api/spotify')
          .then(function (res) {
            if (!res.ok) throw new Error('bad status');
            return res.json();
          })
          .then(function (data) {
            if (data && data.track && trackEl) {
              trackEl.textContent = data.track;
              if (artistEl) artistEl.textContent = data.artist || 'spotify';
              var extraEl = document.getElementById('music-extra');
              if (extraEl) {
                var bits = [];
                if (data.album) bits.push(data.album);
                if (data.year) bits.push(data.year);
                extraEl.textContent = bits.length ? bits.join(' · ') : 'open in spotify ↗';
              }
              if (data.albumArt && artEl) {
                artEl.src = data.albumArt;
                artEl.classList.remove('hidden');
                if (fallbackEl) fallbackEl.classList.add('hidden');
              }
            } else {
              if (trackEl) trackEl.textContent = 'Nothing playing';
              if (artistEl) artistEl.textContent = 'spotify';
            }
          })
          .catch(function () {
            if (trackEl) trackEl.textContent = 'Spotify unavailable';
            if (artistEl) artistEl.textContent = 'check back later ~';
          });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          initMusic();
        });
      } else {
        initMusic();
      }
    })();
  </script>
</Base>
