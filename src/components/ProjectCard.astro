---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  showMedia?: boolean;
}

const { project, showMedia = true } = Astro.props;
---

<article class="relative flex flex-col gap-3.5 group p-3 sm:p-3.5 -mx-3 sm:-mx-3.5 transition-colors duration-200 ease-out hover:bg-[var(--ink)]/[0.04]">
  {/* Full-cell Clickable Link Overlay */}
  <a
    href={project.github || "/projects"}
    target={project.github ? "_blank" : "_self"}
    rel="noopener noreferrer"
    class="absolute inset-0 z-0"
    aria-label={`View ${project.title}`}
  ></a>

  {/* Top Thumbnail (Full Width within cell, 16:10 Aspect Ratio, Hairline Frame) */}
  {showMedia && (
    <div class="relative z-10 w-full aspect-[16/10] overflow-hidden border border-[var(--line)] bg-[var(--surface)] transition-colors duration-200 group-hover:border-[var(--accent)]/60 pointer-events-none">
      {project.coverImage ? (
        <img
          src={project.coverImage}
          alt={project.title}
          loading="lazy"
          class="w-full h-full object-cover block group-hover:scale-[1.02] transition-transform duration-300"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center p-4 text-center font-mono text-[11px] text-[var(--ink-tertiary)] tracking-[0.08em]">
          {project.title}
        </div>
      )}
    </div>
  )}

  <!-- Bottom Text Content Block -->
  <div class="relative z-10 flex flex-col gap-2 pointer-events-none flex-1 justify-between">
    <div class="flex flex-col gap-1.5">
      {/* Title */}
      <h3 class="font-serif font-medium text-[19px] sm:text-[21px] text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors leading-snug">
        {project.title}
      </h3>

      {/* Description */}
      {project.description && (
        <p class="font-serif italic text-[15.5px] sm:text-[17px] text-[var(--ink-secondary)] leading-[1.8]">
          {project.description}
        </p>
      )}
    </div>

    <!-- Tags & View Link Row -->
    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1.5 pt-2 mt-auto font-mono text-[10px] sm:text-[10.5px]">
      <span class="font-semibold uppercase tracking-[0.08em] text-[var(--ink-tertiary)]">
        {project.tags || "PROJECT"}
      </span>

      <span class="font-semibold text-[var(--accent)] tracking-[0.06em] uppercase inline-flex items-center gap-1 group-hover:underline text-[10.5px] sm:text-[11px] shrink-0 ml-auto">
        VIEW &rarr;
      </span>
    </div>
  </div>
</article>
