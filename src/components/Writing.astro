---
import { getCollection } from 'astro:content';

let posts: any[] = [];
try {
  const allPosts = await getCollection('blog');
  posts = allPosts.filter(p => p.data.published);
} catch (e) {
  posts = [];
}
---
<section id="writing" class="w-full px-6 md:px-10 py-16 md:py-24 border-b border-[var(--ink-faint)]/40 flex justify-center">
  <div class="w-full max-w-[640px] flex flex-col gap-8 text-left">
    <!-- Section Label -->
    <div>
      <span class="accent-hover-bracket inline-block font-mono text-[11px] text-[var(--ink)] tracking-[0.1em] border border-[var(--ink-faint)] px-2.5 py-1 select-none bg-[#12110E]/80">
        <span class="bracket">[</span> 04 / WRITING <span class="bracket">]</span>
      </span>
    </div>

    {posts.length === 0 ? (
      /* Intentional Empty State */
      <div class="font-serif italic text-[16px] text-[var(--ink-muted)] py-2">
        &ldquo;nothing here yet &mdash; but things are accumulating.&rdquo;
      </div>
    ) : (
      /* Published Posts List */
      <div class="flex flex-col gap-6">
        {posts.map((post) => (
          <div class="flex flex-col gap-1.5 pb-6 border-b border-[var(--ink-faint)]">
            <div class="flex justify-between items-baseline">
              <a href={`/blog/${post.id}`} class="font-serif text-[16px] text-[var(--ink)] hover:text-[var(--accent)] transition-colors">
                {post.data.title}
              </a>
              <span class="font-mono text-[11px] text-[var(--ink-faint)]">
                {post.data.date}
              </span>
            </div>
            {post.data.excerpt && (
              <p class="font-serif italic text-[14px] text-[var(--ink-muted)]">
                {post.data.excerpt}
              </p>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
