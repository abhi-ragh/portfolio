---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Work from '../components/Work.astro';
import SelectedFrames from '../components/SelectedFrames';
import Footer from '../components/Footer.astro';
import { getHomepageImages } from '../lib/archive';

const archiveItems = await getHomepageImages();
---

<Base>
  <div class="max-w-[1280px] mx-auto min-h-screen px-6 sm:px-10 lg:px-12 flex flex-col lg:flex-row gap-8 lg:gap-16 relative z-10">
    {/* Left Fixed Identity & Nav Sidebar on Desktop / Top Shell on Mobile */}
    <Sidebar />

    {/* Right Scrolling Main Document Column */}
    <main class="flex-1 min-w-0 py-8 lg:py-16 flex flex-col gap-16 lg:gap-24">
      <Hero />
      <Experience />
      <Work />
      <SelectedFrames client:load items={archiveItems} />
      <Footer />
    </main>
  </div>
</Base>
