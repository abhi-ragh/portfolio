---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "abhiragh a r — infrastructure, film, and the space between",
  description = "Personal public space of Abhiragh A R — cloud infrastructure engineer, 35mm film photography, and sketchbook notes based in Kochi, Kerala."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="bg-[#0E0D0B] text-[#F4F1EA]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Lock Dark Reader and Extension Color Overrides -->
    <meta name="darkreader-lock" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>

    <!-- Google Fonts: Lora (Serif) & IBM Plex Mono (Monospace) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Lora:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#0E0D0B] text-[#F4F1EA] min-h-screen relative overflow-x-hidden font-serif">
    <!-- SVG Dither Pattern Definitions -->
    <svg class="absolute w-0 h-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <defs>
        <!-- Sparse Dither (4x4 Bayer, ~25% fill) -->
        <pattern id="dither-sparse" x="0" y="0" width="4" height="4" patternUnits="userSpaceOnUse">
          <rect x="0" y="0" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
          <rect x="2" y="0" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
          <rect x="0" y="2" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
          <rect x="2" y="2" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
        </pattern>

        <!-- Mid Dither (4x4 Bayer, ~50% fill) -->
        <pattern id="dither-mid" x="0" y="0" width="4" height="4" patternUnits="userSpaceOnUse">
          <rect x="0" y="0" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
          <rect x="2" y="0" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
          <rect x="1" y="1" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
          <rect x="3" y="1" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
          <rect x="0" y="2" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
          <rect x="2" y="2" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
          <rect x="1" y="3" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
          <rect x="3" y="3" width="1" height="1" fill="var(--dither-fg)" opacity="0.65"/>
        </pattern>

        <!-- Dense Dither (4x4 Bayer, ~75% fill) -->
        <pattern id="dither-dense" x="0" y="0" width="4" height="4" patternUnits="userSpaceOnUse">
          <rect x="0" y="0" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          <rect x="1" y="0" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          <rect x="2" y="0" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          <rect x="3" y="0" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          
          <rect x="1" y="1" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          <rect x="3" y="1" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          
          <rect x="0" y="2" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          <rect x="1" y="2" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          <rect x="2" y="2" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          <rect x="3" y="2" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          
          <rect x="1" y="3" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
          <rect x="3" y="3" width="1" height="1" fill="var(--dither-fg)" opacity="0.75"/>
        </pattern>

        <!-- Gradient Mask for Hero Section Fade -->
        <linearGradient id="hero-fade-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
          <stop offset="50%" stop-color="#ffffff" stop-opacity="0.6" />
          <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
        </linearGradient>
        <mask id="hero-dither-mask">
          <rect x="0" y="0" width="100%" height="100%" fill="url(#hero-fade-gradient)" />
        </mask>
      </defs>
    </svg>

    <slot />
  </body>
</html>
