---
---
<section id="about" class="sec-relative w-full px-6 md:px-10 pt-[4rem] pb-[3rem] border-b border-[var(--rule)]">
  <!-- Oversized Section Background Number 01 (Faint 0.035 Opacity) -->
  <span class="section-bg-number" aria-hidden="true">01</span>

  <!-- Single Column Container (max-width: 560px, left-aligned) -->
  <div class="relative z-10 w-full max-w-[560px] flex flex-col">
    <!-- Small Monospace Label -->
    <div class="mb-6">
      <span class="accent-hover-bracket inline-block font-mono text-[10px] text-[var(--ink-faint)] tracking-[0.1em] border border-[var(--ink-faint)] px-2 py-0.5 select-none bg-[#12110E]/80 uppercase">
        <span class="bracket">[</span> 01 / ABOUT <span class="bracket">]</span>
      </span>
    </div>

    <!-- Display Line -->
    <h2 class="type-display mb-[2rem]">
      An uneventful life.
    </h2>

    <!-- Poem Block (IBM Plex Mono, 13px, --ink-muted, line-height 1.9, padding-left 1.5rem, 1.4rem stanza gap) -->
    <div class="pl-[1.5rem] flex flex-col gap-[1.4rem] font-mono text-[13px] text-[var(--ink-muted)] leading-[1.9] font-normal not-italic">
      <div>
        Unreadable logs<br />
        Braindead AI
      </div>

      <div>
        A Phone Camera<br />
        A Cup of Coffee<br />
        And a dash of colour
      </div>

      <div>
        Welcome to my corner of the internet
      </div>
    </div>
  </div>
</section>
