---
import type { Blog } from '../lib/types';

interface Props {
  blog: Blog;
  showImage?: boolean;
}

const { blog, showImage = true } = Astro.props;
---

<a
  href={blog.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col border border-[var(--rule)] bg-[var(--surface)] p-5 gap-4 hover:border-[var(--accent)]/60 transition-colors"
>
  {/* Cover Image (Only rendered if showImage is true) */}
  {showImage && (
    <div class="w-full aspect-[16/9] overflow-hidden bg-[var(--surface)]">
      <img
        src={blog.image}
        alt={blog.title}
        loading="lazy"
        class="w-full h-full object-cover block group-hover:brightness-110 transition-all duration-300"
      />
    </div>
  )}

  <!-- Title & Description -->
  <div class="flex flex-col gap-2.5 flex-1">
    <h3 class="font-serif italic text-[18px] md:text-[20px] text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors leading-snug">
      {blog.title}
    </h3>
    {blog.description && (
      <p class="font-serif text-[14px] text-[#4A4540] line-clamp-3 leading-relaxed">
        {blog.description}
      </p>
    )}
  </div>

  <!-- Footer Link -->
  <div class="pt-3 border-t border-[var(--rule)] flex justify-between items-center font-mono text-[11px] text-[#6B6560]">
    <span class="text-[var(--accent)] font-medium">Medium &bull; Article</span>
    <span class="group-hover:translate-x-1 transition-transform">Read on Medium &rarr;</span>
  </div>
</a>
