---
const roles = [
  {
    title: "Junior Engineer — Cloud",
    company: "Saints & Masters",
    date: "May 2026 — Present",
    description: "Building and maintaining AWS infrastructure and CI/CD pipelines for managed service clients.",
    tags: "AWS · Terraform · Docker · GitLab CI/CD · Linux"
  },
  {
    title: "DevOps Intern",
    company: "Saints & Masters",
    date: "Apr 2026",
    description: "Infrastructure automation, deployment pipelines, and Linux system reliability.",
    tags: "Python · Linux · AWS"
  },
  {
    title: "System Engineer Intern",
    company: "Bridge Global",
    date: "Jun 2025 — Dec 2025",
    description: "Internal automation tooling, Linux server administration, and network configuration.",
    tags: "Bash · Networking · Git"
  }
];
---

<section id="experience" class="flex flex-col gap-8 py-8 border-b border-[var(--line)] scroll-mt-12">
  {/* Section Eyebrow */}
  <div>
    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--ink-faint)] border border-[var(--line)] px-2.5 py-1 select-none bg-[var(--surface)]/80 inline-block">
      [ 01 / EXPERIENCE ]
    </span>
  </div>

  {/* Roles Vertical Stack */}
  <div class="flex flex-col gap-10 lg:gap-12">
    {roles.map((role) => (
      <div class="flex flex-col gap-2">
        {/* Title */}
        <h3 class="font-serif font-medium text-[19px] sm:text-[21px] text-[var(--ink)] leading-snug">
          {role.title}
        </h3>

        {/* Company & Date Range */}
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] text-[var(--ink-faint)] tracking-[0.08em]">
          <span class="uppercase font-semibold text-[var(--ink)]">{role.company}</span>
          <span>&middot;</span>
          <span>{role.date}</span>
        </div>

        {/* Single-Sentence Description */}
        <p class="font-serif italic text-[14px] sm:text-[15px] text-[var(--ink)] leading-relaxed mt-1">
          {role.description}
        </p>

        {/* Tech-Tag Line (mono, ·-separated) */}
        <div class="font-mono text-[10px] text-[var(--ink-faint)] tracking-[0.08em] uppercase mt-1">
          {role.tags}
        </div>
      </div>
    ))}
  </div>

  {/* Full Résumé Link (Inline text treatment) */}
  <div class="pt-2">
    <a
      href="https://linkedin.com/in/abhiragh"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-[11px] text-[var(--ink-faint)] hover:text-[var(--accent)] transition-colors inline-flex items-center gap-1 uppercase tracking-[0.08em]"
    >
      Full r&eacute;sum&eacute; &rarr;
    </a>
  </div>
</section>
