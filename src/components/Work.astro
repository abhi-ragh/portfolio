---
import { getHomepageProjects } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

let projects = [];
try {
  projects = await getHomepageProjects();
} catch (e) {
  projects = [];
}
---

<section id="projects" class="sec-relative w-full px-6 md:px-10 pt-[2.5rem] pb-[3rem] border-b border-[var(--rule)]">
  <!-- Oversized Background Number 03 -->
  <span class="section-bg-number" aria-hidden="true">03</span>

  <div class="relative z-10 w-full flex flex-col gap-6 text-left">
    <!-- Header -->
    <div class="flex justify-between items-baseline">
      <div>
        <span class="accent-hover-bracket inline-block font-mono text-[10px] text-[var(--ink-faint)] tracking-[0.1em] border border-[var(--ink-faint)] px-2 py-0.5 select-none bg-[#12110E]/80 uppercase">
          <span class="bracket">[</span> 03 / PROJECTS <span class="bracket">]</span>
        </span>
      </div>

      {projects.length > 0 && (
        <a
          href="/projects"
          class="font-mono text-[10px] text-[var(--ink-muted)] hover:text-[var(--ink)] transition-colors tracking-[0.08em]"
        >
          View All Projects &rarr;
        </a>
      )}
    </div>

    {projects.length === 0 ? (
      /* Reframed Teaser State (Option B per Patch Spec Section 5) */
      <p class="type-opener text-[var(--ink-muted)] italic max-w-md pt-2">
        Things built in the gaps between<br />everything else. More soon.
      </p>
    ) : (
      /* Published Homepage Projects Grid */
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        {projects.map((project) => (
          <ProjectCard project={project} showMedia={false} />
        ))}
      </div>
    )}
  </div>
</section>
