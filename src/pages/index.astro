---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import BentoCard from '../components/BentoCard.astro';
import { getHomepageProjectTeaser } from '../lib/projects.ts';
import { getHomepagePhotograph, getHomepageSketch } from '../lib/archive.ts';
import { getCurrentReading } from '../lib/books.ts';

let projectTeaser = null;
let photographTeaser = null;
let sketchTeaser = null;
let readingTeaser = null;

try {
  projectTeaser = await getHomepageProjectTeaser();
} catch (e) {
  console.warn('Failed to fetch project teaser:', e);
}

try {
  photographTeaser = await getHomepagePhotograph();
} catch (e) {
  console.warn('Failed to fetch photograph teaser:', e);
}

try {
  sketchTeaser = await getHomepageSketch();
} catch (e) {
  console.warn('Failed to fetch sketch teaser:', e);
}

try {
  readingTeaser = await getCurrentReading();
} catch (e) {
  console.warn('Failed to fetch reading teaser:', e);
}

const roles = [
  {
    title: 'Junior Engineer — Cloud',
    company: 'Saints & Masters',
    date: 'May 2026 — Present',
  },
  {
    title: 'DevOps Intern',
    company: 'Saints & Masters',
    date: 'Apr 2026',
  },
  {
    title: 'Associate System Engineer Intern',
    company: 'Bridge Global',
    date: 'Jun 2025 — Dec 2025',
  },
];
---

<Base>
  <div class="mx-auto flex min-h-dvh w-full max-w-[1560px] flex-col px-5 pt-6 pb-8 sm:px-8 sm:pt-7 lg:px-12 xl:px-16 lg:pb-7">
    {/* Top bar — nav on the left, socials on the right */}
    <div class="mb-7 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 sm:mb-9">
      <Nav />

      <div
        class="flex shrink-0 items-center gap-2 whitespace-nowrap font-mono text-[11.5px] tracking-[0.02em] text-[var(--ink-tertiary)]"
      >
        <a href="mailto:abhiragh0@gmail.com" class="transition-colors hover:text-[var(--ink)]">email</a>
        <span aria-hidden="true" class="opacity-50">·</span>
        <a
          href="https://www.github.com/abhi-ragh"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-[var(--ink)]">github</a
        >
        <span aria-hidden="true" class="opacity-50">·</span>
        <a
          href="https://www.linkedin.com/in/abhi-ragh/"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-[var(--ink)]">linkedin</a
        >
      </div>
    </div>

    <main class="bento">
      {/* About — spans the first two columns */}
      <div class="bento-intro flex shrink-0 flex-col gap-8 px-8 pt-10 pb-12 sm:px-14 sm:pt-12 sm:pb-16 lg:px-20">
        <div class="bento-about-text flex flex-col gap-10 sm:gap-12">
          <h1 class="font-serif text-[clamp(30px,4vw,52px)] font-normal leading-[1.2] tracking-tight text-[var(--ink)]">
            Hello there! I'm <strong class="font-medium text-[var(--ink)]">Abhiragh</strong>.
          </h1>

          <div class="flex flex-col gap-8 font-serif text-[clamp(15px,1.4vw,17px)] leading-[2] text-[var(--ink-secondary)] sm:gap-10">
            <p>
              I do a little bit of everything, but <strong class="font-medium text-[var(--ink)]">breaking things</strong> (<span class="font-serif italic text-[var(--ink)]">& maybe fixing them</span>) is kind of my thing.
            </p>

            <p>
              Currently trying to figure out this whole <span class="text-[var(--ink)] underline decoration-dotted decoration-[var(--ink-tertiary)] underline-offset-[5px]">work-life balance</span> thing, but so far, Only thing I got is a <strong class="font-medium italic text-[var(--ink)]">messed-up sleep schedule</strong>.
            </p>

            <p>
              Outside of work, I'm trying to <strong class="font-medium text-[var(--ink)]">read more</strong>, <span class="font-serif italic text-[var(--ink)]">draw more</span>, and <span class="font-serif italic text-[var(--ink-secondary)]">Learn Random things ig....</span>
            </p>
          </div>
        </div>
      </div>

      {/* Column 1: Photograph */}
      <div class="bento-col bento-col-1">
        {/* Photograph card — completely fills the box, zero borders, top title pops up on hover only */}
        <a
          href="/archive"
          class="bento-photo group relative block shrink-0 overflow-hidden rounded-[20px] bg-[var(--surface)] transition-all duration-300"
          aria-label="View photograph in archive"
        >
          {photographTeaser?.imageUrl ? (
            <img
              src={photographTeaser.imageUrl}
              alt={photographTeaser.caption}
              loading="lazy"
              class="block h-auto w-full transition-transform duration-700 group-hover:scale-[1.03]"
            />
          ) : (
            <div class="flex aspect-[3/2] w-full items-center justify-center">
              <span class="font-mono text-[11px] text-[var(--ink-tertiary)]">no frames yet ~</span>
            </div>
          )}

          {/* Top title bar — pops up on hover only */}
          <div class="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-center justify-between p-3.5 bg-gradient-to-b from-black/60 via-black/25 to-transparent opacity-0 -translate-y-1 transition-all duration-300 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 group-focus-visible:translate-y-0">
            <div class="flex items-center gap-1.5 font-mono text-[11px] text-white">
              <span class="opacity-70">Gallery</span>
              <span class="opacity-40">·</span>
              <span class="font-sans font-medium text-white">{photographTeaser?.caption || 'Photograph'}</span>
            </div>
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white shadow-xs text-neutral-900 text-[11px] leading-none transition-transform duration-200 group-hover:scale-105">
              ↗
            </span>
          </div>
        </a>

      </div>

      {/* Column 2: Career + Screen + Books */}
      <div class="bento-col bento-col-2">
        {/* Career card — current job & company, skills pop on hover only */}
        <BentoCard
          category="Career"
          href="https://www.linkedin.com/in/abhi-ragh/"
          external
          class="bento-career min-h-[125px] shrink-0"
          reveal
          bodyClass="p-4 sm:p-5 h-full flex flex-col justify-center"
        >
          <div class="flex flex-col justify-center">
            <span class="font-mono text-[9.5px] uppercase tracking-wider text-[var(--ink-tertiary)]">
              Present · Full-time
            </span>
            <h3 class="font-serif text-[17px] sm:text-[18px] font-normal leading-snug text-[var(--ink)] mt-0.5">
              Junior Engineer — Cloud
            </h3>
            <p class="font-serif italic text-[14px] text-[var(--ink-secondary)] mt-0.5">
              Saints & Masters
            </p>
            {/* Skills pop up only when hovered */}
            <div class="mt-2.5 flex flex-wrap gap-1.5 opacity-0 max-h-0 overflow-hidden transition-all duration-300 ease-out group-hover:opacity-100 group-hover:max-h-20">
              {['AWS', 'Azure', 'Kubernetes', 'Terraform', 'Docker', 'Linux'].map((tech) => (
                <span class="rounded-full bg-[var(--surface-hover)] px-2 py-0.5 font-mono text-[9px] uppercase tracking-wider text-[var(--ink-secondary)]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </BentoCard>

        {/* Screen / Animation card */}
        <BentoCard category="Canvas" title="Sine Flow" class="bento-screen h-[130px] shrink-0" bare>
          <div class="relative h-full w-full overflow-hidden rounded-[20px] bg-[var(--surface)]">
            <canvas id="screen-loop" class="absolute inset-0 block h-full w-full"></canvas>
          </div>
        </BentoCard>

        {/* Reading card (compact) */}
        <BentoCard
          category="Reading"
          title="Books"
          class="bento-reading h-[152px] shrink-0"
          reveal
          bodyClass="px-4 py-3.5 h-full flex items-center"
        >
          <div class="flex h-full min-w-0 items-center gap-4">
            {readingTeaser?.coverImage ? (
              <div
                class="relative aspect-[2/3] h-[112px] shrink-0 overflow-hidden rounded-[8px] bg-[var(--surface-hover)] shadow-[0_10px_30px_-12px_rgba(0,0,0,0.45)] ring-1 ring-black/5"
              >
                <img src={readingTeaser.coverImage} alt="" loading="lazy" class="h-full w-full object-cover" />
              </div>
            ) : (
              <div class="flex aspect-[2/3] h-[112px] shrink-0 items-center justify-center rounded-[8px] bg-[var(--surface-hover)] font-mono text-[13px] text-[var(--ink-tertiary)] shadow-[0_10px_30px_-12px_rgba(0,0,0,0.45)]">
                📖
              </div>
            )}
            <div class="flex min-w-0 flex-1 flex-col gap-1.5">
              <span class="inline-block w-fit rounded px-1.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400">
                {readingTeaser?.status || 'READING'}
              </span>
              <p class="font-serif line-clamp-2 text-[16px] leading-snug text-[var(--ink)]">
                {readingTeaser?.title || 'No book in progress'}
              </p>
              <p class="truncate font-sans text-[12px] text-[var(--ink-secondary)]">
                {readingTeaser?.author || 'check back soon ~'}
              </p>
            </div>
          </div>
        </BentoCard>
      </div>

      {/* Column 3: Obi-Wan GIF + Project + Music + Sketch */}
      <div class="bento-col bento-col-3">
        {/* Obi-Wan Kenobi GIF box — full-bleed, no title overlay */}
        <div
          class="bento-hello group relative block shrink-0 overflow-hidden rounded-[20px] bg-[var(--surface)] transition-all duration-300 aspect-[480/208] w-full"
          title="Hello there! — Obi-Wan Kenobi"
        >
          <img
            src="/obi-wan-hello-there.gif"
            alt="Obi-Wan Kenobi saying Hello there"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          />
        </div>

        {/* Project card — completely fills the box, zero borders, top title pops up on hover only */}
        <a
          href={projectTeaser?.github || '/projects'}
          target={projectTeaser?.github ? '_blank' : undefined}
          rel={projectTeaser?.github ? 'noopener noreferrer' : undefined}
          class="bento-project group relative flex h-[260px] shrink-0 overflow-hidden rounded-[20px] bg-[var(--surface)] transition-all duration-300"
          aria-label={`View ${projectTeaser?.title || 'project'}`}
        >
          {projectTeaser?.coverImage ? (
            <img
              src={projectTeaser.coverImage}
              alt={projectTeaser.title}
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center">
              <span class="font-mono text-[11px] text-[var(--ink-tertiary)]">no featured project yet ~</span>
            </div>
          )}

          {/* Top title bar — pops up on hover only */}
          <div class="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-center justify-between p-3.5 bg-gradient-to-b from-black/60 via-black/25 to-transparent opacity-0 -translate-y-1 transition-all duration-300 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 group-focus-visible:translate-y-0">
            <div class="flex items-center gap-1.5 font-mono text-[11px] text-white">
              <span class="opacity-70">Projects</span>
              <span class="opacity-40">·</span>
              <span class="font-sans font-medium text-white">{projectTeaser?.title || 'Featured'}</span>
            </div>
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white shadow-xs text-neutral-900 text-[11px] leading-none transition-transform duration-200 group-hover:scale-105">
              ↗
            </span>
          </div>
        </a>

        {/* Music card — rotating circular vinyl thumbnail matching uploaded screenshot */}
        <BentoCard
          category="Music"
          title="Recently played"
          class="bento-music h-[105px] shrink-0"
          reveal
          bodyClass="px-4 py-3 h-full flex items-center"
        >
          <div class="flex w-full min-w-0 items-center gap-3.5">
            <div
              class="relative flex aspect-square h-[56px] w-[56px] shrink-0 items-center justify-center overflow-hidden rounded-full bg-[var(--surface-hover)] shadow-xs"
            >
              <img
                id="music-art"
                src=""
                alt=""
                class="hidden h-full w-full object-cover rounded-full animate-[spin_12s_linear_infinite]"
              />
              <span id="music-art-fallback" class="font-serif text-[18px] text-[var(--ink-tertiary)]">♪</span>
            </div>
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
              <div class="flex items-center gap-1.5">
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-mono text-[9px] uppercase tracking-wider text-[var(--ink-tertiary)]">Spotify</span>
              </div>
              <p id="music-track" class="font-serif line-clamp-1 text-[15px] font-medium leading-tight text-[var(--ink)]">
                —
              </p>
              <p id="music-artist" class="truncate font-mono text-[10.5px] text-[var(--ink-secondary)]">
                loading spotify…
              </p>
            </div>
          </div>
        </BentoCard>

        {/* Sketch card (tall) — completely fills the box, zero borders, top title pops up on hover only */}
        <a
          href="/archive"
          class="bento-sketch group relative block shrink-0 overflow-hidden rounded-[20px] bg-[var(--surface)] transition-all duration-300"
          aria-label="View sketch in archive"
        >
          {sketchTeaser?.imageUrl ? (
            <img
              src={sketchTeaser.imageUrl}
              alt={sketchTeaser.caption}
              loading="lazy"
              class="block h-auto w-full transition-transform duration-700 group-hover:scale-[1.03]"
            />
          ) : (
            <div class="flex aspect-[3/2] w-full items-center justify-center">
              <span class="font-mono text-[11px] text-[var(--ink-tertiary)]">no drafts yet ~</span>
            </div>
          )}

          {/* Top title bar — pops up on hover only */}
          <div class="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-center justify-between p-3.5 bg-gradient-to-b from-black/60 via-black/25 to-transparent opacity-0 -translate-y-1 transition-all duration-300 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 group-focus-visible:translate-y-0">
            <div class="flex items-center gap-1.5 font-mono text-[11px] text-white">
              <span class="opacity-70">Gallery</span>
              <span class="opacity-40">·</span>
              <span class="font-sans font-medium text-white">{sketchTeaser?.caption || 'Sketch'}</span>
            </div>
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white shadow-xs text-neutral-900 text-[11px] leading-none transition-transform duration-200 group-hover:scale-105">
              ↗
            </span>
          </div>
        </a>
      </div>
    </main>

  </div>

  <style>
    :global(.bento) {
      display: grid;
      gap: 0.85rem;
      grid-template-columns: 1fr;
    }

    @media (max-width: 1023px) {
      :global(.bento-col) {
        display: contents;
      }
      :global(.bento-intro) { order: 1; min-height: 170px; }
      :global(.bento-hello) { order: 2; }
      :global(.bento-career) { order: 3; min-height: 125px; }
      :global(.bento-sketch) { order: 4; }
      :global(.bento-project) { order: 5; min-height: 240px; }
      :global(.bento-photo) { order: 6; }
      :global(.bento-music) { order: 7; min-height: 105px; }
      :global(.bento-reading) { order: 8; min-height: 152px; }
      :global(.bento-screen) { order: 9; min-height: 130px; }
    }

    @media (min-width: 1024px) {
      :global(.bento) {
        --breakout: 12rem;
        grid-template-columns: 1fr 1.1fr 1fr;
        grid-template-rows: auto 1fr;
      }

      /* About keeps its position but yields width so the project can grow into it */
      :global(.bento-about-text) {
        max-width: min(720px, calc(100% - var(--breakout)));
      }

      /* Project card breaks out of column 3 — the Obi-Wan GIF above is untouched */
      :global(.bento-project) {
        margin-left: calc(var(--breakout) * -1);
        width: calc(100% + var(--breakout));
      }

      :global(.bento-intro) {
        grid-column: 1 / 3;
        grid-row: 1;
      }

      :global(.bento-col-1) { grid-column: 1; grid-row: 2; }
      :global(.bento-col-2) { grid-column: 2; grid-row: 2; }
      :global(.bento-col-3) { grid-column: 3; grid-row: 1 / span 2; }

      :global(.bento-col) {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }
    }
  </style>

  <script is:inline>
    (function () {
      // ---- Screen / Animation card: flowing wave lines ----
      function initScreenLoop() {
        var canvas = document.getElementById('screen-loop');
        if (!canvas || !canvas.getContext) return;

        var ctx = canvas.getContext('2d');
        var width = 0;
        var height = 0;
        var animId = null;
        var time = 0;
        var prefersReducedMotion =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function resize() {
          var rect = canvas.parentElement ? canvas.parentElement.getBoundingClientRect() : null;
          if (!rect) return;
          var dpr = Math.min(window.devicePixelRatio || 1, 2);
          width = rect.width;
          height = rect.height;
          canvas.width = Math.max(1, Math.floor(width * dpr));
          canvas.height = Math.max(1, Math.floor(height * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function draw() {
          ctx.clearRect(0, 0, width, height);
          var inkColor = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#171717';
          var lines = 4;
          for (var i = 0; i < lines; i++) {
            var baseY = height * (0.3 + 0.14 * i);
            ctx.beginPath();
            for (var x = 0; x <= width; x += 2) {
              var y =
                baseY +
                Math.sin(x * 0.022 + time * (0.55 + i * 0.16) + i * 1.7) *
                  (height * 0.075);
              if (x === 0) ctx.moveTo(x, y);
              else ctx.lineTo(x, y);
            }
            ctx.save();
            ctx.strokeStyle = inkColor;
            ctx.globalAlpha = Math.max(0.08, 0.45 - i * 0.1);
            ctx.lineWidth = 1.25;
            ctx.stroke();
            ctx.restore();
          }

          if (!prefersReducedMotion) {
            time += 0.016;
            animId = requestAnimationFrame(draw);
          }
        }

        function start() {
          resize();
          window.addEventListener('resize', resize, { passive: true });
          draw();
          document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'hidden') {
              if (animId) cancelAnimationFrame(animId);
            } else if (!prefersReducedMotion) {
              animId = requestAnimationFrame(draw);
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start);
        } else {
          start();
        }
      }

      // ---- Music card: recently played from server endpoint ----
      function initMusic() {
        var trackEl = document.getElementById('music-track');
        var artistEl = document.getElementById('music-artist');
        var artEl = document.getElementById('music-art');
        var fallbackEl = document.getElementById('music-art-fallback');

        fetch('/api/spotify')
          .then(function (res) {
            if (!res.ok) throw new Error('bad status');
            return res.json();
          })
          .then(function (data) {
            if (data && data.track && trackEl) {
              trackEl.textContent = data.track;
              if (artistEl) artistEl.textContent = data.artist || 'spotify';
              if (data.albumArt && artEl) {
                artEl.src = data.albumArt;
                artEl.classList.remove('hidden');
                if (fallbackEl) fallbackEl.classList.add('hidden');
              }
            } else {
              if (trackEl) trackEl.textContent = 'Nothing playing';
              if (artistEl) artistEl.textContent = 'spotify';
            }
          })
          .catch(function () {
            if (trackEl) trackEl.textContent = 'Spotify unavailable';
            if (artistEl) artistEl.textContent = 'check back later ~';
          });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          initScreenLoop();
          initMusic();
        });
      } else {
        initScreenLoop();
        initMusic();
      }
    })();
  </script>
</Base>
