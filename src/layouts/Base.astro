---
import '../styles/global.css';
import DitherBackground from '../components/DitherBackground.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "abhiragh a r — infrastructure, film, and the space between",
  description = "Personal public space of Abhiragh A R — cloud infrastructure engineer, 35mm film photography, and sketchbook notes based in Kochi, Kerala."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="bg-[var(--paper)] text-[var(--ink)]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Lock Dark Theme -->
    <meta name="darkreader-lock" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>

    <!-- Google Fonts: Caveat (Handwriting System A), Lora (Serif) & IBM Plex Mono (Monospace) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Lora:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet">
  </head>
  <body class="bg-transparent text-[var(--ink)] min-h-screen relative overflow-x-hidden font-serif">
    <DitherBackground />
    <slot />
  </body>
</html>
