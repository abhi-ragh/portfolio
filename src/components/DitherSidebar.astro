---
/**
 * DitherSidebar.astro
 * A vertical dither strip — used as the right edge of the About section's
 * left column, running its full height.
 *
 * Props:
 *   width:   number in px  (default: 10)
 *   density: 'sparse' | 'mid' | 'dense'  (default: 'mid')
 */

interface Props {
  width?: number;
  density?: 'sparse' | 'mid' | 'dense';
}

const { width = 10, density = 'mid' } = Astro.props;

const BAYER_4X4 = [
  [ 0,  8,  2, 10],
  [12,  4, 14,  6],
  [ 3, 11,  1,  9],
  [15,  7, 13,  5],
];

const THRESHOLDS = { sparse: 4, mid: 8, dense: 12 };
const threshold = THRESHOLDS[density];
const CELL = 4;
const PATTERN_SIZE = CELL * 4;

const filledCells: { x: number; y: number }[] = [];
for (let row = 0; row < 4; row++) {
  for (let col = 0; col < 4; col++) {
    if (BAYER_4X4[row][col] < threshold) {
      filledCells.push({ x: col * CELL, y: row * CELL });
    }
  }
}

const patternId = `dither-sidebar-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="dither-sidebar" style={`width: ${width}px;`} aria-hidden="true">
  <svg
    width={width}
    height="100%"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="none"
  >
    <defs>
      <pattern
        id={patternId}
        x="0"
        y="0"
        width={PATTERN_SIZE}
        height={PATTERN_SIZE}
        patternUnits="userSpaceOnUse"
      >
        {filledCells.map(({ x, y }) => (
          <rect
            x={x}
            y={y}
            width={CELL}
            height={CELL}
            fill="var(--dither-fg, #E8E4DC)"
          />
        ))}
      </pattern>
    </defs>
    <rect width={width} height="100%" fill={`url(#${patternId})`} />
  </svg>
</div>

<style>
  .dither-sidebar {
    height: 100%;
    flex-shrink: 0;
    display: block;
  }
</style>
