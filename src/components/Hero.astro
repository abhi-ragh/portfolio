---
import HeroTicker from './HeroTicker.jsx';
---
<section class="relative w-full min-h-screen h-[100vh] flex flex-col justify-end pb-[17vh] md:pb-[19vh] px-6 md:px-10 overflow-hidden">
  {/* Hero Text Overlay */}
  <div class="relative z-[10] max-w-[1000px] flex flex-col gap-4">
    <h1 class="font-serif text-[46px] sm:text-[60px] md:text-[72px] font-normal leading-[1.06] text-black tracking-tight">
      infrastructure, film,<br />
      and the space between.
    </h1>

    <div class="font-mono text-[11px] sm:text-[12px] text-black font-medium tracking-[0.12em] uppercase mt-1">
      Cloud Engineer, Linux Enthusiast, Your Friendly Neighbourhood Nerd
    </div>
  </div>

  {/* Seamless Hacker News & Live IST Ticker */}
  <HeroTicker client:load />
</section>

