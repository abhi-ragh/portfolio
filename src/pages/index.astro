---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Work from '../components/Work.astro';
import SelectedFrames from '../components/SelectedFrames';
import { getHomepageImages } from '../lib/archive';

const archiveItems = await getHomepageImages();
---

<Base>
  <div class="w-full max-w-[1536px] mx-auto min-h-screen px-6 sm:px-10 lg:px-12 xl:px-16 flex flex-col lg:flex-row gap-8 lg:gap-12 xl:gap-16 relative z-10">
    {/* Left Fixed Identity & Nav Sidebar on Desktop / Bottom Shell on Mobile */}
    <Sidebar />

    {/* Right Scrolling Main Document Column (Centered inside available track) */}
    <main class="flex-1 min-w-0 py-8 lg:py-16 px-0 lg:px-4 xl:px-8">
      <div class="w-full max-w-[920px] xl:max-w-[960px] mx-auto flex flex-col gap-8 lg:gap-12">
        <Hero />
        <Experience />
        <Work />
        <SelectedFrames client:load items={archiveItems} />
      </div>
    </main>
  </div>
</Base>
