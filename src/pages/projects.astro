---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getArchiveProjects } from '../lib/projects.ts';

let projects = [];
try {
  projects = await getArchiveProjects();
} catch (e) {
  projects = [];
}
---

<Base title="Projects — abhiragh a r">
  <div class="mx-auto flex min-h-dvh w-full max-w-[1560px] flex-col px-5 pt-6 pb-5 sm:px-8 sm:pt-7 lg:px-12 xl:px-16 lg:pb-7">
    <Nav active="projects" />

    <main class="mt-8 flex-1 lg:mt-10">
      <div class="mb-8 flex flex-col gap-2 lg:mb-10">
        <h1 class="font-serif text-[38px] font-medium leading-none tracking-tight text-[var(--ink)] sm:text-[48px]">projects</h1>
        <p class="font-mono text-[11px] tracking-[0.04em] text-[var(--ink-tertiary)]">
          side projects and experiments :P
        </p>
      </div>

      {projects.length === 0 ? (
        <div class="font-serif text-[16px] italic text-[var(--ink-secondary)]">
          Projects coming soon ~
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-5">
          {projects.map((project) => (
            <ProjectCard project={project} showMedia={true} />
          ))}
        </div>
      )}
    </main>

    <SiteFooter class="mt-10" />
  </div>
</Base>
