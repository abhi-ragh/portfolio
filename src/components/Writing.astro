---
import { getHomepageBlogs } from '../lib/blogs';

let blogs: any[] = [];
try {
  blogs = await getHomepageBlogs();
} catch (e) {
  blogs = [];
}
---

<section id="writing" class="section-writing">
  <!-- Top Bar -->
  <div class="writing-top-bar">
    <span class="section-label">[ 05 / WRITING ]</span>
    <a href="/blogs" class="writing-view-all">View all writing &rarr;</a>
  </div>

  <!-- Main Heading -->
  <h2 class="writing-main-heading">Writing.</h2>

  <!-- Horizontal Newspaper Spread Grid dynamically rendering all Notion homepage blogs -->
  <div class="writing-newspaper-grid">
    {blogs.map((blog: any, idx: number) => (
      <article key={blog.id || idx} class="writing-newspaper-col">
        <h3 class="writing-col-title">
          <a
            href={blog.url || blog.slug ? (blog.url || `/blogs/${blog.slug}`) : "/blogs"}
            target={blog.url && blog.url.startsWith('http') ? "_blank" : "_self"}
            rel="noopener noreferrer"
          >
            {blog.title}
          </a>
        </h3>

        {blog.description && (
          <p class="writing-col-excerpt">{blog.description}</p>
        )}

        <div class="writing-col-footer">
          <span class="writing-col-meta">
            {blog.tag || "Medium"} &bull; {blog.readTime || "5 min read"}
          </span>
          <a
            href={blog.url || blog.slug ? (blog.url || `/blogs/${blog.slug}`) : "/blogs"}
            target={blog.url && blog.url.startsWith('http') ? "_blank" : "_self"}
            rel="noopener noreferrer"
            class="writing-col-link"
          >
            Read &rarr;
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
