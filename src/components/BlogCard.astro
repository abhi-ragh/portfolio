---
import type { Blog } from '../lib/types';

interface Props {
  blog: Blog;
  showImage?: boolean;
}

const { blog, showImage = true } = Astro.props;
---

<a
  href={blog.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col gap-3.5"
>
  {/* Cover Image with hairline frame */}
  {showImage && (
    <div class="w-full aspect-[16/9] overflow-hidden border border-[var(--line)] bg-[var(--surface)] transition-colors group-hover:border-[var(--accent)]/60">
      <img
        src={blog.image}
        alt={blog.title}
        loading="lazy"
        class="w-full h-full object-cover block group-hover:scale-[1.02] transition-transform duration-300"
      />
    </div>
  )}

  <!-- Title & Description -->
  <div class="flex flex-col gap-2 flex-1">
    <h3 class="font-serif italic text-[18px] md:text-[20px] text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors leading-snug">
      {blog.title}
    </h3>
    {blog.description && (
      <p class="font-serif text-[14px] text-[var(--ink-secondary)] line-clamp-3 leading-relaxed">
        {blog.description}
      </p>
    )}
  </div>

  <!-- Footer Link -->
  <div class="pt-2 flex justify-between items-center font-mono text-[11px] text-[var(--ink-tertiary)]">
    <span class="text-[var(--accent)] font-medium uppercase tracking-[0.06em]">Medium &middot; Article</span>
    <span class="group-hover:translate-x-1 group-hover:text-[var(--ink)] transition-all">Read on Medium &rarr;</span>
  </div>
</a>
