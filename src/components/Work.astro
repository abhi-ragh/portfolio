---
import { getHomepageProjects } from '../lib/projects';

let projects: any[] = [];
try {
  projects = await getHomepageProjects();
} catch (e) {
  projects = [];
}
---

<section id="projects" class="section-projects">
  <!-- Top Bar -->
  <div class="projects-top-bar">
    <span class="section-label">[ 05 / PROJECTS ]</span>
    <a href="/projects" class="projects-view-all">View all projects &rarr;</a>
  </div>

  <!-- Horizontal Exhibition Grid -->
  <div class="projects-exhibition-grid">
    {projects.map((proj: any, idx: number) => (
      <article key={proj.id || idx} class="project-exhibition-item">
        <a
          href={proj.github || "/projects"}
          target={proj.github ? "_blank" : "_self"}
          rel="noopener noreferrer"
          class="project-thumb-anchor"
        >
          <div class="project-thumb-box">
            {proj.coverImage ? (
              <img
                src={proj.coverImage}
                alt={proj.title}
                class="project-thumb-img"
                loading="lazy"
              />
            ) : (
              <div class="project-thumb-empty">
                <span>{proj.title}</span>
              </div>
            )}
          </div>
        </a>

        <h3 class="project-item-title">
          <a
            href={proj.github || "/projects"}
            target={proj.github ? "_blank" : "_self"}
            rel="noopener noreferrer"
          >
            {proj.title}
          </a>
        </h3>

        {proj.description && (
          <p class="project-item-desc">{proj.description}</p>
        )}

        <div class="project-item-tags">
          {proj.tags || "PROJECT"}
        </div>

        <a
          href={proj.github || "/projects"}
          target={proj.github ? "_blank" : "_self"}
          rel="noopener noreferrer"
          class="project-item-link"
        >
          View &rarr;
        </a>
      </article>
    ))}
  </div>
</section>
