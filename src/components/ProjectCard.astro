---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  showMedia?: boolean;
}

const { project, showMedia = true } = Astro.props;
---

<article class="relative flex flex-col sm:flex-row gap-4 sm:gap-5 lg:gap-6 group items-start p-2.5 sm:p-3 -mx-2.5 sm:-mx-3 transition-colors duration-200 ease-out hover:bg-[var(--ink)]/[0.04]">
  {/* Full-row Clickable Link Overlay */}
  <a
    href={project.github || "/projects"}
    target={project.github ? "_blank" : "_self"}
    rel="noopener noreferrer"
    class="absolute inset-0 z-0"
    aria-label={`View ${project.title}`}
  ></a>

  {/* Left Thumbnail Column (Compact ~160px Width & 16:10 Aspect Ratio) */}
  {showMedia && (
    <div class="relative z-10 block w-full sm:w-[150px] md:w-[165px] lg:w-[175px] shrink-0 overflow-hidden border border-[var(--line)] bg-[var(--surface)] transition-all duration-200 group-hover:border-[var(--accent)]/60 pointer-events-none">
      <div class="w-full aspect-[16/10] overflow-hidden bg-[var(--surface)]">
        {project.coverImage ? (
          <img
            src={project.coverImage}
            alt={project.title}
            loading="lazy"
            class="w-full h-full object-cover block group-hover:scale-[1.02] transition-transform duration-300"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center p-3 text-center font-mono text-[10px] text-[var(--ink-tertiary)] tracking-[0.08em]">
            {project.title}
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Right Text Content Block -->
  <div class="relative z-10 flex-1 min-w-0 flex flex-col justify-between self-stretch gap-2 pointer-events-none">
    <div class="flex flex-col gap-1">
      <h3 class="font-serif font-medium text-[17px] sm:text-[18px] text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors leading-snug">
        {project.title}
      </h3>
      {project.description && (
        <p class="font-serif italic text-[13px] sm:text-[14px] text-[var(--ink-secondary)] leading-relaxed line-clamp-2">
          {project.description}
        </p>
      )}
    </div>

    <!-- Tags & View Link Row -->
    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 pt-0.5 font-mono text-[10px]">
      <span class="font-semibold uppercase tracking-[0.08em] text-[var(--ink-tertiary)]">
        {project.tags || "PROJECT"}
      </span>

      {project.github && (
        <span class="font-semibold text-[var(--accent)] group-hover:underline flex items-center gap-1 uppercase tracking-[0.06em] text-[10.5px] shrink-0 ml-auto">
          VIEW &rarr;
        </span>
      )}
    </div>
  </div>
</article>
