---
import { getHomepageProjects } from '../lib/projects';

let projects: any[] = [];
try {
  projects = await getHomepageProjects();
} catch (e) {
  projects = [];
}
---

<section id="projects" class="flex flex-col gap-8 scroll-mt-20">
  {/* Projects Vertical Row Stack */}
  <div class="flex flex-col gap-8 lg:gap-10">
    {projects.map((proj: any, idx: number) => (
      <article key={proj.id || idx} class="flex flex-col sm:flex-row gap-5 sm:gap-6 lg:gap-7 group items-start">
        {/* Left Thumbnail Column (Fixed Width & 16:10 Aspect Ratio) */}
        <a
          href={proj.github || "/projects"}
          target={proj.github ? "_blank" : "_self"}
          rel="noopener noreferrer"
          class="block w-full sm:w-[220px] md:w-[240px] lg:w-[260px] shrink-0 overflow-hidden border border-[var(--line)] bg-[var(--surface)] transition-all duration-300 group-hover:border-[var(--accent)]/60"
        >
          <div class="w-full aspect-[16/10] overflow-hidden bg-[var(--surface)]">
            {proj.coverImage ? (
              <img
                src={proj.coverImage}
                alt={proj.title}
                class="w-full h-full object-cover block transition-transform duration-300 group-hover:scale-[1.02]"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center p-4 text-center font-mono text-[11px] text-[var(--ink-tertiary)] tracking-[0.08em]">
                {proj.title}
              </div>
            )}
          </div>
        </a>

        {/* Right Text Content Block */}
        <div class="flex-1 min-w-0 flex flex-col justify-between self-stretch gap-2.5">
          <div class="flex flex-col gap-1.5">
            {/* Title (same weight/scale as Experience role titles) */}
            <h3 class="font-serif font-medium text-[19px] sm:text-[21px] text-[var(--ink)] leading-snug group-hover:text-[var(--accent)] transition-colors">
              <a
                href={proj.github || "/projects"}
                target={proj.github ? "_blank" : "_self"}
                rel="noopener noreferrer"
              >
                {proj.title}
              </a>
            </h3>

            {/* Description (italic one-liner, same style as Experience) */}
            {proj.description && (
              <p class="font-serif italic text-[14px] sm:text-[15px] text-[var(--ink-secondary)] leading-relaxed">
                {proj.description}
              </p>
            )}
          </div>

          {/* Tags & View Link Row */}
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 pt-1 font-mono text-[10px]">
            <span class="font-semibold uppercase tracking-[0.08em] text-[var(--ink-tertiary)]">
              {proj.tags || "PROJECT"}
            </span>

            <a
              href={proj.github || "/projects"}
              target={proj.github ? "_blank" : "_self"}
              rel="noopener noreferrer"
              class="font-semibold text-[var(--accent)] tracking-[0.06em] uppercase inline-flex items-center gap-1 hover:underline text-[11px] shrink-0 ml-auto"
            >
              VIEW &rarr;
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>

  {/* Full projects list → Link at end of section */}
  <div class="pt-2">
    <a
      href="/projects"
      class="font-mono text-[11px] font-semibold text-[var(--ink-secondary)] hover:text-[var(--accent)] transition-colors inline-flex items-center gap-1 uppercase tracking-[0.08em]"
    >
      Full projects list &rarr;
    </a>
  </div>
</section>
