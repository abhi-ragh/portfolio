---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Work from '../components/Work.astro';
import SelectedFrames from '../components/SelectedFrames';
import Footer from '../components/Footer.astro';
import { getArchiveImages } from '../lib/archive';

const archiveItems = await getArchiveImages();
---

<Base>
  <div class="relative w-full min-h-screen bg-[#F5F0E8] overflow-hidden">
    <!-- Z-30: Foreground Content Layer -->
    <div class="relative z-30 w-full">
      <Nav />
      <main class="w-full">
        <Hero />
        
        <div class="relative w-full overflow-hidden">
          <Experience />
          <Work />
          <SelectedFrames client:load items={archiveItems} />
          <Footer />
        </div>
      </main>
    </div>
  </div>
</Base>

