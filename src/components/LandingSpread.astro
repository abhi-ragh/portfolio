<section class="relative w-full h-screen min-h-[640px] flex flex-col justify-between pt-[72px] pb-8 z-30 px-6 md:px-10">
  <!-- Upper Region: Hero Headline (~80vh) -->
  <div class="relative z-30 max-w-[900px] flex flex-col gap-4 mt-auto mb-10 md:mb-12">
    <h1 class="font-serif text-[38px] sm:text-[48px] md:text-[56px] font-normal leading-[1.12] text-[var(--ink)] tracking-tight">
      infrastructure, film,<br />
      and the space between.
    </h1>

    <div class="font-mono text-[11px] text-[var(--ink-muted)] tracking-[0.12em] uppercase">
      Lost Somewhere &mdash; 9.9312° N, 76.2673° E
    </div>
  </div>

  <!-- Lower Region: About Preview (~20vh Fold) -->
  <div id="about" class="relative z-30 w-full flex flex-col gap-3">
    <div>
      <span class="accent-hover-bracket inline-block font-mono text-[11px] text-[var(--ink)] tracking-[0.1em] border border-[var(--ink-faint)] px-2.5 py-1 select-none bg-[#12110E]/80">
        <span class="bracket">[</span> 01 / ABOUT <span class="bracket">]</span>
      </span>
    </div>
    <p class="font-serif italic text-[15px] sm:text-[16px] md:text-[17px] text-[var(--ink)] leading-relaxed max-w-3xl">
      I spend my days keeping cloud infrastructure from falling apart &mdash; AWS, mostly, for clients who can't afford downtime.
    </p>
  </div>
</section>
