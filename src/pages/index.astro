---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import BentoCard from '../components/BentoCard.astro';
import MediaCard from '../components/MediaCard.astro';
import BentoProjectCard from '../components/BentoProjectCard.astro';
import BookCard from '../components/BookCard.astro';
import { getHomepageProjects } from '../lib/projects.ts';
import { getHomepageImages } from '../lib/archive.ts';
import { getHomepageActivities } from '../lib/books.ts';

let featuredProject = null;
let restProjects = [];
let projectColumns = [[], [], []];
let bookColumns = [[], [], []];
let mediaColumns = [[], [], []];
let mediaItems = [];
let activities = [];

const GAP = 13.6; // 0.85rem, matches the bento gap

/**
 * Deals each card into whichever column is currently shortest, using real
 * intrinsic dimensions measured at build time.
 *
 * Columns are sized in `fr` units, so their widths keep a fixed 1 : 1.1 : 1
 * ratio at every viewport. Heights scale uniformly with that ratio, which
 * means the packing decision made here stays correct at any screen size.
 *
 * Avoids stacking same-type cards by adding a small penalty when the last
 * item in a column matches the current item's kind.
 */
function packByHeight(items, widths, seeds = []) {
  const totals = widths.map((_, i) => seeds[i] ?? 0);
  const buckets = widths.map(() => []);
  const SAME_KIND_PENALTY = 40; // px — enough to nudge to next column

  for (const item of items) {
    let bestCol = 0;
    let bestScore = Infinity;

    for (let i = 0; i < totals.length; i++) {
      let score = totals[i];
      // Penalize if last item in this column is same kind
      const last = buckets[i][buckets[i].length - 1];
      if (last && last.kind === item.kind) {
        score += SAME_KIND_PENALTY;
      }
      if (score < bestScore) {
        bestScore = score;
        bestCol = i;
      }
    }

    buckets[bestCol].push(item);
    totals[bestCol] += cardHeight(item, widths[bestCol]) + GAP;
  }

  return buckets;
}

/**
 * Ceiling on a media card, as a multiple of the card width so it scales with
 * the fluid columns. Aspect ratio is never touched — a tall image is scaled
 * down to fit and the card then hugs it.
 * Keep in sync with MEDIA_HEIGHT_FACTOR in MediaCard.astro.
 *
 * Deliberately NOT applied here. Planning with the cap makes the estimates
 * scale unevenly — a capped image stops shrinking with the viewport while the
 * uncapped ones keep going — which is what threw the narrow-width columns out
 * of balance. CSS still enforces the cap; the packer just plans without it and
 * absorbs the small difference.
 */
const MEDIA_HEIGHT_FACTOR = 1.26;

/** Media cards size to their own ratio; project and book cards are fixed. */
function cardHeight(item, columnWidth) {
  if (item.kind === 'project') return 260;
  if (item.kind === 'book') return 152;
  const ratio = item.width && item.height ? item.width / item.height : 1.5;
  return columnWidth / ratio;
}

try {
  // First ticked project stays the wide featured card in column 3.
  // Any extras are packed by height like the media cards.
  const [featured, ...rest] = await getHomepageProjects();
  featuredProject = featured ?? null;
  restProjects = rest;
} catch (e) {
  console.warn('Failed to fetch homepage projects:', e);
}

try {
  const home = await getHomepageImages();
  // Photographs and sketches are just media cards — no column is reserved
  // for either. Every ticked image is packed into the shortest column.
  mediaItems = [...home.photographs, ...home.sketches].map((item) => ({ ...item, kind: 'media' }));
} catch (e) {
  console.warn('Failed to fetch homepage images:', e);
}

try {
  // Every activity ticked on the homepage, each showing its own Status.
  activities = (await getHomepageActivities()).map((activity) => ({ ...activity, kind: 'book' }));
} catch (e) {
  console.warn('Failed to fetch homepage activities:', e);
}

// Column widths follow the 1fr 1.1fr 1fr grid. Because those are fr units the
// ratio is constant, so any reference width yields the same packing.
const COLUMN_RATIOS = [1, 1.1, 1];
const REFERENCE_WIDTH = 1312;
const unit = (REFERENCE_WIDTH - GAP * 2) / COLUMN_RATIOS.reduce((a, b) => a + b, 0);
const columnWidths = COLUMN_RATIOS.map((r) => r * unit);

// Each column already holds fixed-height cards before any packed image lands,
// so that height is banked up front. Column 3 additionally starts a full row
// higher, which its GIF + featured project + music card roughly cancel out.
const columnSeeds = [
  0,
  125 + GAP,                    // career
  179 + 260 + 132 + GAP * 3,    // gif + featured project + music
];

// Media and extra projects are packed in a single joint pass, so a tall image
// placed early can still be balanced against a project card later.
// Interleave by type (round-robin) so activities, images, projects mix naturally.
// Then pack — seeded for deterministic builds.
function interleaveByKind<T extends { kind: string }>(items: T[], order: string[]): T[] {
  const buckets = new Map<string, T[]>();
  for (const kind of order) buckets.set(kind, items.filter(i => i.kind === kind));
  const result: T[] = [];
  let remaining = items.length;
  while (remaining > 0) {
    for (const kind of order) {
      const bucket = buckets.get(kind);
      if (bucket && bucket.length > 0) {
        result.push(bucket.shift()!);
        remaining--;
      }
    }
  }
  return result;
}

const allItems = interleaveByKind([
  ...mediaItems,
  ...restProjects.map((project) => ({ ...project, kind: 'project' })),
  ...activities,
], ['media', 'project', 'book']);

const packed = packByHeight(allItems, columnWidths, columnSeeds);

mediaColumns = packed.map((col) => col.filter((item) => item.kind === 'media'));
projectColumns = packed.map((col) => col.filter((item) => item.kind === 'project'));
bookColumns = packed.map((col) => col.filter((item) => item.kind === 'book'));

const roles = [
  {
    title: 'Junior Engineer — Cloud',
    company: 'Saints & Masters',
    date: 'May 2026 — Present',
  },
  {
    title: 'DevOps Intern',
    company: 'Saints & Masters',
    date: 'Apr 2026',
  },
  {
    title: 'Associate System Engineer Intern',
    company: 'Bridge Global',
    date: 'Jun 2025 — Dec 2025',
  },
];
---

<Base>
  <div class="mx-auto flex min-h-dvh w-full max-w-[1560px] flex-col px-5 pt-6 pb-8 sm:px-8 sm:pt-7 lg:px-12 xl:px-16 lg:pb-7">
    {/* Top bar — nav on the left, socials on the right */}
    <div class="mb-7 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 sm:mb-9">
      <Nav />

      <div
        class="flex shrink-0 items-center gap-2 whitespace-nowrap font-mono text-[11.5px] tracking-[0.02em] text-[var(--ink-tertiary)]"
      >
        <a href="mailto:abhiragh0@gmail.com" class="transition-colors hover:text-[var(--ink)]">email</a>
        <span aria-hidden="true" class="opacity-50">·</span>
        <a
          href="https://www.github.com/abhi-ragh"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-[var(--ink)]">github</a
        >
        <span aria-hidden="true" class="opacity-50">·</span>
        <a
          href="https://www.linkedin.com/in/abhi-ragh/"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-[var(--ink)]">linkedin</a
        >
      </div>
    </div>

    <main class="bento">
      {/* About — spans the first two columns */}
      <div class="bento-intro flex shrink-0 flex-col gap-8 px-8 pt-10 pb-12 sm:px-14 sm:pt-12 sm:pb-16 lg:px-20">
        <div class="bento-about-text flex flex-col gap-10 sm:gap-12">
          <h1 class="font-serif text-[clamp(30px,4vw,52px)] font-normal leading-[1.2] tracking-tight text-[var(--ink)]">
            Hello there! I'm <strong class="font-medium text-[var(--ink)]">Abhiragh</strong>.
          </h1>

          <div class="flex flex-col gap-8 font-serif text-[clamp(15px,1.4vw,17px)] leading-[2] text-[var(--ink-secondary)] sm:gap-10">
            <p>
              I do a little bit of everything, but <strong class="font-medium text-[var(--ink)]">breaking things</strong> (<span class="font-serif italic text-[var(--ink)]">& maybe fixing them</span>) is kind of my thing.
            </p>

            <p>
              Currently trying to figure out this whole <span class="text-[var(--ink)] underline decoration-dotted decoration-[var(--ink-tertiary)] underline-offset-[5px]">work-life balance</span> thing, but so far, Only thing I got is a <strong class="font-medium italic text-[var(--ink)]">messed-up sleep schedule</strong>.
            </p>

            <p>
              Outside of work, I'm trying to <strong class="font-medium text-[var(--ink)]">read more</strong>, <span class="font-serif italic text-[var(--ink)]">draw more</span>, and <span class="font-serif italic text-[var(--ink-secondary)]">Learn Random things ig....</span>
            </p>
          </div>
        </div>
      </div>

      {/* Column 1: media dealt round-robin from the shared pool */}
      <div class="bento-col bento-col-1">
        {mediaColumns[0].map((item) => (
          <MediaCard src={item.imageUrl} caption={item.caption} width={item.width} height={item.height} />
        ))}

        {bookColumns[0].map((book) => (
          <BookCard
            title={book.title}
            author={book.author}
            coverImage={book.coverImage}
            status={book.status}
            coverFitsGrid={book.coverFitsGrid}
            coverWidth={book.coverWidth}
            coverHeight={book.coverHeight}
          />
        ))}

        {projectColumns[0].map((project) => (
          <BentoProjectCard
            title={project.title}
            coverImage={project.coverImage}
            github={project.github}
          />
        ))}
      </div>

      {/* Column 2: Career + Screen + Books */}
      <div class="bento-col bento-col-2">
        {/* Career card — current job & company, skills pop on hover only */}
        <BentoCard
          category="Career"
          href="https://www.linkedin.com/in/abhi-ragh/"
          external
          class="bento-career min-h-[125px] shrink-0"
          reveal
          bodyClass="p-4 sm:p-5 h-full flex flex-col justify-center"
        >
          <div class="flex flex-col justify-center">
            <span class="font-mono text-[9.5px] uppercase tracking-wider text-[var(--ink-tertiary)]">
              Present · Full-time
            </span>
            <h3 class="font-serif text-[17px] sm:text-[18px] font-normal leading-snug text-[var(--ink)] mt-0.5">
              Junior Engineer — Cloud
            </h3>
            <p class="font-serif italic text-[14px] text-[var(--ink-secondary)] mt-0.5">
              Saints & Masters
            </p>
            {/* Skills pop up only when hovered */}
            <div class="mt-2.5 flex flex-wrap gap-1.5 opacity-0 max-h-0 overflow-hidden transition-all duration-300 ease-out group-hover:opacity-100 group-hover:max-h-20">
              {['AWS', 'Azure', 'Kubernetes', 'Terraform', 'Docker', 'Linux'].map((tech) => (
                <span class="rounded-full bg-[var(--surface-hover)] px-2 py-0.5 font-mono text-[9px] uppercase tracking-wider text-[var(--ink-secondary)]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </BentoCard>

        {mediaColumns[1].map((item) => (
          <MediaCard src={item.imageUrl} caption={item.caption} width={item.width} height={item.height} />
        ))}

        {bookColumns[1].map((book) => (
          <BookCard
            title={book.title}
            author={book.author}
            coverImage={book.coverImage}
            status={book.status}
            coverFitsGrid={book.coverFitsGrid}
            coverWidth={book.coverWidth}
            coverHeight={book.coverHeight}
          />
        ))}

        {projectColumns[1].map((project) => (
          <BentoProjectCard
            title={project.title}
            coverImage={project.coverImage}
            github={project.github}
          />
        ))}
      </div>

      {/* Column 3: Obi-Wan GIF + Project + Music + media */}
      <div class="bento-col bento-col-3">
        {/* Obi-Wan Kenobi GIF box — full-bleed, no title overlay */}
        <div
          class="bento-hello group relative block shrink-0 overflow-hidden rounded-[20px] bg-[var(--surface)] transition-all duration-300 aspect-[480/208] w-full"
          title="Hello there! — Obi-Wan Kenobi"
        >
          <img
            src="/obi-wan-hello-there.gif"
            alt="Obi-Wan Kenobi saying Hello there"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          />
        </div>

        {/* Featured project — the one wide card, directly under the GIF */}
        {featuredProject ? (
          <BentoProjectCard
            wide
            title={featuredProject.title}
            coverImage={featuredProject.coverImage}
            github={featuredProject.github}
            category="Featured"
          />
        ) : (
          <div class="bento-project bento-project--wide group relative flex h-[260px] shrink-0 items-center justify-center overflow-hidden rounded-[20px] bg-[var(--surface)] transition-all duration-300">
            <span class="font-mono text-[11px] text-[var(--ink-tertiary)]">no featured project yet ~</span>
          </div>
        )}

        {/* Music card — rotating circular vinyl thumbnail matching uploaded screenshot */}
        <BentoCard
          category="Recently played"
          class="bento-music h-[132px] shrink-0 transition-transform duration-300 ease-out hover:z-20 hover:scale-[1.03]"
          reveal
          bodyClass="px-4 py-3 h-full flex items-center"
        >
          <div class="flex w-full min-w-0 items-center gap-3.5">
            <div
              class="relative flex aspect-square h-[56px] w-[56px] shrink-0 items-center justify-center overflow-hidden rounded-full bg-[var(--surface-hover)] shadow-xs transition-all duration-300 ease-out group-hover:h-[70px] group-hover:w-[70px]"
            >
              <img
                id="music-art"
                src=""
                alt=""
                class="hidden h-full w-full object-cover rounded-full animate-[spin_12s_linear_infinite]"
              />
              <span id="music-art-fallback" class="font-serif text-[18px] text-[var(--ink-tertiary)]">♪</span>
            </div>
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
              <div class="flex items-center gap-1.5">
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-mono text-[9px] uppercase tracking-wider text-[var(--ink-tertiary)]">Spotify</span>
              </div>
              <p id="music-track" class="font-serif line-clamp-1 text-[15px] font-medium leading-tight text-[var(--ink)]">
                —
              </p>
              <p id="music-artist" class="truncate font-mono text-[10.5px] text-[var(--ink-secondary)]">
                loading spotify…
              </p>
              {/* Album + year stay hidden until hover */}
              <div class="grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-out group-hover:grid-rows-[1fr] group-hover:opacity-100">
                <div class="overflow-hidden">
                  <p id="music-extra" class="truncate font-mono text-[10px] leading-tight text-[var(--ink-tertiary)]">
                    —
                  </p>
                </div>
              </div>
            </div>
          </div>
        </BentoCard>

        {mediaColumns[2].map((item) => (
          <MediaCard src={item.imageUrl} caption={item.caption} width={item.width} height={item.height} />
        ))}

        {bookColumns[2].map((book) => (
          <BookCard
            title={book.title}
            author={book.author}
            coverImage={book.coverImage}
            status={book.status}
            coverFitsGrid={book.coverFitsGrid}
            coverWidth={book.coverWidth}
            coverHeight={book.coverHeight}
          />
        ))}

        {projectColumns[2].map((project) => (
          <BentoProjectCard
            title={project.title}
            coverImage={project.coverImage}
            github={project.github}
          />
        ))}

        {mediaItems.length === 0 && (
          <div class="bento-media flex aspect-[3/2] w-full shrink-0 items-center justify-center rounded-[20px] bg-[var(--surface)]">
            <span class="font-mono text-[11px] text-[var(--ink-tertiary)]">no frames yet ~</span>
          </div>
        )}
      </div>
    </main>

  </div>

  <style>
    :global(.bento) {
      display: grid;
      gap: 0.85rem;
      grid-template-columns: 1fr;
    }

    @media (max-width: 1023px) {
      :global(.bento-col) {
        display: contents;
      }
      :global(.bento-intro) { order: 1; min-height: 170px; }
      :global(.bento-hello) { order: 2; }
      :global(.bento-career) { order: 3; min-height: 125px; }
      :global(.bento-project) { order: 4; min-height: 240px; }
      :global(.bento-media) { order: 5; }
      :global(.bento-music) { order: 6; min-height: 132px; }
      :global(.bento-book) { order: 7; min-height: 152px; }
    }

    @media (min-width: 1024px) {
      :global(.bento) {
        --breakout: 6rem;
        grid-template-columns: 1fr 1.1fr 1fr;
        grid-template-rows: auto 1fr;
      }

      /* About keeps its position but yields width so the project can grow into it */
      :global(.bento-about-text) {
        max-width: min(720px, calc(100% - var(--breakout)));
      }

      /* Only the featured project breaks out — safe in column 3, which sits
         clear of the columns below it. Extras stay at column width. */
      :global(.bento-project--wide) {
        margin-left: calc(var(--breakout) * -1);
        width: calc(100% + var(--breakout));
      }

      :global(.bento-intro) {
        grid-column: 1 / 3;
        grid-row: 1;
      }

      :global(.bento-col-1) { grid-column: 1; grid-row: 2; }
      :global(.bento-col-2) { grid-column: 2; grid-row: 2; }
      :global(.bento-col-3) { grid-column: 3; grid-row: 1 / span 2; }

      :global(.bento-col) {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }
    }
  </style>

  <script is:inline>
    (function () {
      // ---- Music card: recently played from server endpoint ----
      function initMusic() {
        var trackEl = document.getElementById('music-track');
        var artistEl = document.getElementById('music-artist');
        var artEl = document.getElementById('music-art');
        var fallbackEl = document.getElementById('music-art-fallback');

        fetch('/api/spotify')
          .then(function (res) {
            if (!res.ok) throw new Error('bad status');
            return res.json();
          })
          .then(function (data) {
            if (data && data.track && trackEl) {
              trackEl.textContent = data.track;
              if (artistEl) artistEl.textContent = data.artist || 'spotify';
              var extraEl = document.getElementById('music-extra');
              if (extraEl) {
                var bits = [];
                if (data.album) bits.push(data.album);
                if (data.year) bits.push(data.year);
                extraEl.textContent = bits.length ? bits.join(' · ') : 'open in spotify ↗';
              }
              if (data.albumArt && artEl) {
                artEl.src = data.albumArt;
                artEl.classList.remove('hidden');
                if (fallbackEl) fallbackEl.classList.add('hidden');
              }
            } else {
              if (trackEl) trackEl.textContent = 'Nothing playing';
              if (artistEl) artistEl.textContent = 'spotify';
            }
          })
          .catch(function () {
            if (trackEl) trackEl.textContent = 'Spotify unavailable';
            if (artistEl) artistEl.textContent = 'check back later ~';
          });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          initMusic();
        });
      } else {
        initMusic();
      }
    })();
  </script>
</Base>
