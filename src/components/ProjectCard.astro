---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
  showMedia?: boolean;
}

const { project, showMedia = true } = Astro.props;
---

<div class="flex flex-col gap-4 border border-[var(--line)] bg-[var(--surface)]/50 p-5 group hover:border-[var(--accent)]/60 transition-colors">
  {/* Plain image crop with hairline border */}
  {showMedia && project.coverImage && (
    <div class="w-full aspect-[16/10] overflow-hidden border border-[var(--line)] bg-[var(--surface)]">
      <img
        src={project.coverImage}
        alt={project.title}
        loading="lazy"
        class="w-full h-full object-cover block group-hover:scale-[1.01] transition-transform duration-300"
      />
    </div>
  )}

  <!-- Title & Description -->
  <div class="flex flex-col gap-2">
    <h3 class="font-serif text-[18px] sm:text-[20px] font-medium text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors leading-snug">
      {project.title}
    </h3>
    {project.description && (
      <p class="font-serif italic text-[14px] text-[var(--ink-faint)] leading-relaxed">
        {project.description}
      </p>
    )}
  </div>

  <!-- Tags & Link -->
  <div class="flex items-center justify-between pt-3 border-t border-[var(--line)] font-mono text-[10px]">
    <span class="uppercase tracking-[0.08em] text-[var(--ink-faint)]">
      {project.tags || "PROJECT"}
    </span>

    {project.github && (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[var(--accent)] hover:underline flex items-center gap-1 uppercase tracking-[0.06em]"
      >
        <span>View &rarr;</span>
      </a>
    )}
  </div>
</div>
