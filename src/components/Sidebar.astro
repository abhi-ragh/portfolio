---
interface Props {
  activeSection?: string;
}

const { activeSection = '' } = Astro.props;
---

<header class="w-full lg:w-[320px] xl:w-[360px] lg:h-screen lg:sticky lg:top-0 flex flex-col justify-end gap-6 lg:gap-8 py-8 lg:py-16 shrink-0 z-40 lg:pr-8 order-last lg:order-first">
  <!-- Top Block: Identity Stack -->
  <div class="flex flex-col gap-6">
    <!-- Identity Stack in Exact Spec Order -->
    <div class="flex flex-col gap-1.5">
      {/* 1. abhiragh (Handwritten, large & bold) */}
      <a href="/" class="font-hand text-[48px] sm:text-[86px] font-bold text-[var(--ink)] leading-none tracking-tight hover:text-[var(--accent)] transition-colors inline-block select-none">
        abhiragh
      </a>

      {/* 2. Cloud Engineer (Normal type, smaller, directly under name) */}
      <h2 class="font-serif text-[17px] sm:text-[18px] text-[var(--ink)] font-normal leading-snug">
        Cloud Engineer
      </h2>

      {/* 3. One-line tech/identity summary (reusing top tags) */}
      <div class="font-mono text-[11px] text-[var(--ink-tertiary)] tracking-[0.1em] uppercase font-semibold mt-1">
        AWS &middot; Linux &middot; Docker
      </div>

      {/* 4. Kerala, India (Small normal/mono type) */}
      <div class="font-mono text-[11px] text-[var(--ink-tertiary)] tracking-[0.06em]">
        Kerala, India
      </div>
    </div>

    <!-- 5. Nav Links (Primary Navigation with Active Section Highlighting) -->
    <nav id="sidebar-nav" class="flex flex-wrap lg:flex-col gap-3 lg:gap-3.5 mt-4 lg:mt-6 font-mono text-[11px] uppercase tracking-[0.12em]">
      <a
        href="/#about"
        data-nav-item="about"
        class="nav-item group flex items-center gap-3 text-[var(--ink-tertiary)] hover:text-[var(--ink)] transition-all py-1"
      >
        <span class="nav-indicator h-[1px] w-4 bg-[var(--ink-tertiary)]/40 group-hover:w-8 group-hover:bg-[var(--accent)] transition-all hidden lg:inline-block"></span>
        <span class="nav-text transition-colors">ABOUT</span>
      </a>
      <a
        href="/#experience"
        data-nav-item="experience"
        class="nav-item group flex items-center gap-3 text-[var(--ink-tertiary)] hover:text-[var(--ink)] transition-all py-1"
      >
        <span class="nav-indicator h-[1px] w-4 bg-[var(--ink-tertiary)]/40 group-hover:w-8 group-hover:bg-[var(--accent)] transition-all hidden lg:inline-block"></span>
        <span class="nav-text transition-colors">EXPERIENCE</span>
      </a>
      <a
        href="/#projects"
        data-nav-item="projects"
        class="nav-item group flex items-center gap-3 text-[var(--ink-tertiary)] hover:text-[var(--ink)] transition-all py-1"
      >
        <span class="nav-indicator h-[1px] w-4 bg-[var(--ink-tertiary)]/40 group-hover:w-8 group-hover:bg-[var(--accent)] transition-all hidden lg:inline-block"></span>
        <span class="nav-text transition-colors">PROJECTS</span>
      </a>
      <a
        href="/#collection"
        data-nav-item="collection"
        class="nav-item group flex items-center gap-3 text-[var(--ink-tertiary)] hover:text-[var(--ink)] transition-all py-1"
      >
        <span class="nav-indicator h-[1px] w-4 bg-[var(--ink-tertiary)]/40 group-hover:w-8 group-hover:bg-[var(--accent)] transition-all hidden lg:inline-block"></span>
        <span class="nav-text transition-colors">COLLECTION</span>
      </a>
    </nav>
  </div>

  <!-- 6. Bottom-anchored within column: github, linkedin, email & Theme Toggle -->
  <div class="flex flex-col gap-3 mt-8 lg:mt-0 font-mono text-[11px] tracking-[0.08em] text-[var(--ink-secondary)] select-none">
    <div class="flex items-center gap-3">
      <a href="https://www.github.com/abhi-ragh" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors lowercase">
        github
      </a>
      <span>&middot;</span>
      <a href="https://www.linkedin.com/in/abhi-ragh/" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--ink)] transition-colors lowercase">
        linkedin
      </a>
      <span>&middot;</span>
      <a href="mailto:abhiragh0@gmail.com" class="hover:text-[var(--ink)] transition-colors lowercase">
        email
      </a>
    </div>

    {/* Minimal Plain Text Theme Toggle Button */}
    <div class="pt-0.5">
      <button
        id="theme-toggle-btn"
        type="button"
        class="font-mono text-[11px] text-[var(--ink-secondary)] hover:text-[var(--accent)] transition-colors cursor-pointer inline-flex items-center gap-1.5 uppercase tracking-[0.1em]"
        aria-label="Toggle theme mode"
      >
        <span id="theme-toggle-icon" class="text-[12px]">☾</span>
        <span id="theme-toggle-label">DARK</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    function initSidebar() {
      // 1. Theme Toggle
      const btn = document.getElementById('theme-toggle-btn');
      const icon = document.getElementById('theme-toggle-icon');
      const label = document.getElementById('theme-toggle-label');

      function updateUI(theme) {
        if (icon && label) {
          if (theme === 'dark') {
            icon.textContent = '☾';
            label.textContent = 'DARK';
          } else {
            icon.textContent = '☀';
            label.textContent = 'LIGHT';
          }
        }
      }

      const initialTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      updateUI(initialTheme);

      if (btn && !btn.dataset.bound) {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', current);
          localStorage.setItem('theme', current);
          updateUI(current);
          window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: current } }));
        });
      }

      // 2. Active Section Scrollspy Highlighting
      const navItems = document.querySelectorAll('#sidebar-nav [data-nav-item]');
      if (!navItems.length) return;

      function setActive(activeId) {
        navItems.forEach(item => {
          const id = item.getAttribute('data-nav-item');
          const indicator = item.querySelector('.nav-indicator');
          const text = item.querySelector('.nav-text');

          if (id === activeId) {
            item.classList.add('active-nav');
            item.classList.remove('text-[var(--ink-tertiary)]');
            item.classList.add('text-[var(--ink)]');
            if (indicator) {
              indicator.classList.remove('w-4', 'bg-[var(--ink-tertiary)]/40');
              indicator.classList.add('w-8', 'bg-[var(--accent)]');
            }
            if (text) {
              text.classList.remove('text-[var(--ink-tertiary)]');
              text.classList.add('text-[var(--accent)]', 'font-semibold');
            }
          } else {
            item.classList.remove('active-nav');
            item.classList.add('text-[var(--ink-tertiary)]');
            item.classList.remove('text-[var(--ink)]');
            if (indicator) {
              indicator.classList.add('w-4', 'bg-[var(--ink-tertiary)]/40');
              indicator.classList.remove('w-8', 'bg-[var(--accent)]');
            }
            if (text) {
              text.classList.add('text-[var(--ink-tertiary)]');
              text.classList.remove('text-[var(--accent)]', 'font-semibold');
            }
          }
        });
      }

      const isHomepage = window.location.pathname === '/' || window.location.pathname === '';

      if (isHomepage) {
        const sectionIds = ['about', 'experience', 'projects', 'collection'];
        const sectionElements = sectionIds.map(id => document.getElementById(id)).filter(Boolean);

        let ticking = false;
        function onScroll() {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              const scrollY = window.scrollY;
              const viewportHeight = window.innerHeight;
              const triggerOffset = scrollY + (viewportHeight * 0.35);

              let current = sectionIds[0];

              // Bottom of page priority
              if ((window.innerHeight + window.scrollY) >= (document.documentElement.scrollHeight - 80)) {
                current = 'collection';
              } else {
                for (let i = 0; i < sectionElements.length; i++) {
                  const section = sectionElements[i];
                  if (triggerOffset >= section.offsetTop) {
                    current = section.id;
                  }
                }
              }

              setActive(current);
              ticking = false;
            });
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll(); // Run immediately for initial page position

        // Immediate feedback on link click
        navItems.forEach(link => {
          link.addEventListener('click', () => {
            const targetId = link.getAttribute('data-nav-item');
            if (targetId && sectionIds.includes(targetId)) {
              setActive(targetId);
            }
          });
        });
      } else {
        const path = window.location.pathname;
        if (path.startsWith('/projects')) setActive('projects');
        else if (path.startsWith('/archive')) setActive('collection');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSidebar);
    } else {
      initSidebar();
    }
  })();
</script>
