<section id="about" class="w-full px-6 md:px-10 py-16 md:py-24">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
    <!-- Left Column (35% ~ 4-5 cols out of 12) -->
    <div class="md:col-span-4 flex flex-col gap-8 pr-0 md:pr-8">
      <!-- Section Index Label -->
      <div>
        <span class="accent-hover-bracket inline-block font-mono text-[11px] text-[var(--ink-faint)] tracking-[0.1em] border border-[var(--ink-faint)] px-2 py-1 select-none">
          <span class="bracket">[</span> 01 / ABOUT <span class="bracket">]</span>
        </span>
      </div>

      <!-- Static Metadata Block -->
      <div class="font-mono text-[11px] flex flex-col gap-2">
        <div class="flex items-baseline justify-start gap-4">
          <span class="w-[84px] shrink-0 text-[var(--ink-faint)]">location</span>
          <span class="text-[var(--ink-muted)]">kochi, kerala</span>
        </div>
        <div class="flex items-baseline justify-start gap-4">
          <span class="w-[84px] shrink-0 text-[var(--ink-faint)]">role</span>
          <span class="text-[var(--ink-muted)]">devops / cloud</span>
        </div>
        <div class="flex items-baseline justify-start gap-4">
          <span class="w-[84px] shrink-0 text-[var(--ink-faint)]">employer</span>
          <span class="text-[var(--ink-muted)]">saints & masters</span>
        </div>
        <div class="flex items-baseline justify-start gap-4">
          <span class="w-[84px] shrink-0 text-[var(--ink-faint)]">currently</span>
          <span class="text-[var(--ink-muted)]">shooting 35mm</span>
        </div>
      </div>
    </div>

    <!-- Right Column (65% ~ 8 cols out of 12) -->
    <div class="md:col-span-8 flex flex-col gap-6 font-serif text-[15px] text-[var(--ink)] leading-[1.85]">
      <p>
        I spend my days keeping cloud infrastructure from falling apart &mdash; AWS, mostly, for clients who can't afford downtime. The kind of work that's invisible when it goes right and very loud when it doesn't.
      </p>
      <p>
        Outside that, I shoot film and fill sketchbooks. Both are about noticing things slowly, which is the opposite of what I do at work. The tension is the point.
      </p>
      <p>
        This is my corner of the internet. No personal brand, no funnel. Just the work and the things I find interesting.
      </p>
    </div>
  </div>
</section>
