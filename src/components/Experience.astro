---
const roles = [
  {
    title: "Junior Engineer — Cloud",
    company: "Saints & Masters",
    date: "May 2026 — Present",
    description: "Maintain AWS and Azure infrastructure for managed service clients. Manage CI/CD pipelines, Kubernetes environments, Infrastructure as Code, and internal platform tools. Provide 24/7 monitoring and support. Troubleshoot incidents and implement vulnerability remediations. Maintain system availability and security.",
    tags: "Python · AWS · Azure · Docker · Kubernetes · Terraform · ArgoCD · Grafana · Prometheus · Loki · PostgreSQL · GitHub Actions · Jenkins · Linux"
  },
  {
    title: "DevOps Intern",
    company: "Saints & Masters",
    date: "Apr 2026",
    description: "Monitored client workloads and responded to alerts. Configured web servers and supported AWS and Azure infrastructure. Maintained process documentation. Reviewed system logs to identify and resolve issues at an early stage.",
    tags: "Python · AWS · Azure · Apache · Nginx · Grafana · Alloy · Linux · Bash"
  },
  {
    title: "Associate System Engineer Intern",
    company: "Bridge Global",
    date: "Jun 2025 — Dec 2025",
    description: "Provided internal IT support and Linux system administration. Installed and configured systems and resolved daily issues for development, design, and DevOps teams. Configured network servers. Troubleshot hardware and software issues.",
    tags: "Python · Linux · Bash · C · MySQL · GitLab CI/CD · AWS · Apache"
  }
];
---

<section id="experience" class="flex flex-col gap-6 scroll-mt-20">
  {/* Roles Plain Vertical Stack with Subtle Hairline Dividers */}
  <div class="flex flex-col divide-y divide-[var(--line)]/40">
    {roles.map((role, idx) => (
      <div class={`flex flex-col ${idx === 0 ? 'pb-8 sm:pb-9 lg:pb-10' : idx === roles.length - 1 ? 'pt-8 sm:pt-9 lg:pt-10' : 'py-8 sm:py-9 lg:py-10'}`}>
        {/* Title & Company Meta Group */}
        <div class="flex flex-col gap-1.5">
          <h3 class="font-serif font-medium text-[19px] sm:text-[21px] text-[var(--ink)] leading-snug">
            {role.title}
          </h3>

          {/* Company & Date Range */}
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] tracking-[0.08em]">
            <span class="uppercase font-semibold text-[var(--ink-secondary)]">{role.company}</span>
            <span class="text-[var(--ink-tertiary)]">&middot;</span>
            <span class="text-[var(--ink-tertiary)]">{role.date}</span>
          </div>
        </div>

        {/* Description */}
        <p class="font-serif italic text-[15.5px] sm:text-[17px] text-[var(--ink-secondary)] leading-[1.8] mt-3 sm:mt-3.5">
          {role.description}
        </p>

        {/* Tech-Tag Line (mono, ·-separated) */}
        <div class="font-mono text-[10px] sm:text-[10.5px] text-[var(--ink-tertiary)] tracking-[0.08em] uppercase font-semibold mt-3.5 sm:mt-4 leading-[1.85]">
          {role.tags}
        </div>
      </div>
    ))}
  </div>

  {/* Full Résumé Link (Inline text treatment) */}
  <div class="pt-1">
    <a
      href="https://www.linkedin.com/in/abhi-ragh/"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-[11px] font-semibold text-[var(--ink-secondary)] hover:text-[var(--accent)] transition-colors inline-flex items-center gap-1 uppercase tracking-[0.08em]"
    >
      Full r&eacute;sum&eacute; &rarr;
    </a>
  </div>
</section>
