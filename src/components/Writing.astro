---
import { getHomepageBlogs } from '../lib/blogs';
import BlogCard from './BlogCard.astro';

let blogs = [];
try {
  blogs = await getHomepageBlogs();
} catch (e) {
  blogs = [];
}
---

<section id="writing" class="w-full px-6 md:px-10 py-10 md:py-12 flex justify-center">
  <div class="w-full flex flex-col gap-6 text-left">
    <!-- Header with Link to All Blogs -->
    <div class="flex justify-between items-baseline">
      <div class="flex items-baseline gap-4">
        <span class="accent-hover-bracket inline-block font-mono text-[11px] text-[var(--ink)] tracking-[0.1em] border border-[var(--ink-faint)] px-2.5 py-1 select-none bg-[#12110E]/80">
          <span class="bracket">[</span> 05 / WRITING <span class="bracket">]</span>
        </span>
      </div>

      {blogs.length > 0 && (
        <a
          href="/blogs"
          class="font-serif italic text-[14px] text-[var(--ink)] hover:text-[var(--accent)] transition-colors flex items-center gap-1.5 group"
        >
          <span>View All Writing</span>
          <span class="font-mono text-[12px] group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      )}
    </div>

    {blogs.length === 0 ? (
      /* Editorial Empty State */
      <div class="font-serif italic text-[15px] text-[var(--ink-muted)] py-2">
        Yet to come.
      </div>
    ) : (
      /* Homepage Blog Cards Grid (No Cover Image: Title & Description Only) */
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {blogs.map((blog) => (
          <BlogCard blog={blog} showImage={false} />
        ))}
      </div>
    )}
  </div>
</section>
